;===============================================================================
; Program   : v65C02 BIOS
; File Name : bios.a65
; Project   : v65C02 8-bit Computer
; Author    : Ryan Clarke
; E-mail    : kj6msg@icloud.com
;===============================================================================
; Purpose : BIOS for the v65C02 8-bit computer.
;===============================================================================


.PC02

.INCLUDE    "v65C02.inc"

.IMPORT     __VRAM_START__
.IMPORT     __VRAM_SIZE__

.IMPORT     monitor


;= CONSTANTS ===================================================================

.DEFINE     VERSION .CONCAT("v65C02 BIOS v", "2.0.0")

            ATTRIB = (BLACK << 4) | LIGHT_GRAY      ; light gray on black text


;===============================================================================
; BIOS
;===============================================================================

.CODE

;= ENTRY POINT =================================================================

bios:       stz     VGA_STATUS          ; disable VGA and cursor
            
            lda     #.HIBYTE(__VRAM_START__ + __VRAM_SIZE__ - 1)
            sta     VRAMH
            lda     #.LOBYTE(__VRAM_START__ + __VRAM_SIZE__ - 1)
            sta     VRAML               ; (VRAM) = VRAM end address
            
            ;- clear VRAM with default attribute -------------------------------
@clrscr:    lda     #ATTRIB             ; A = default text attribute
            sta     (VRAM)              ; store attribute to VRAM
            dec     VRAML               ; decrement VRAM address LSB
            lda     #NUL                ; A = NUL
            sta     (VRAM)              ; store NUL to VRAM
            dec     VRAML               ; decrement VRAM address LSB
            lda     VRAML               ; A = VRAM address LSB
            cmp     #$FF                ; VRAML roll over to $FF?
            bne     @clrscr             ; no, loop
            
            dec     VRAMH               ; decrement VRAM address MSB
            lda     VRAMH               ; A = VRAM address MSB
            cmp     #.HIBYTE(__VRAM_START__ - 1)
            bne     @clrscr             ; VRAM address MSB >= start? loop
            
            stz     VGA_CURSH
            stz     VGA_CURSL           ; set cursor to (0,0)
            stz     COL
            stz     ROW                 ; update stored cursor coordinates
            
            lda     #VGA_EN             ; VGA enabled, cursor disabled
            sta     VGA_STATUS          ; write new status register
            
            lda     #ATTRIB             ; A = default text attribute
            sta     ATTR                ; save in ATTR

            ;- SSEG initialization ---------------------------------------------
            stz     SSEG_DIGITS
            stz     SSEG_DP
            stz     SSEG_BYTE0
            stz     SSEG_BYTE1
            stz     SSEG_BYTE2
            stz     SSEG_BYTE3
            
            ;- BIOS call table address -----------------------------------------
            lda     #.LOBYTE(bios_tbl_l)
            sta     BIOSTLL
            lda     #.HIBYTE(bios_tbl_l)
            sta     BIOSTLH
            lda     #.LOBYTE(bios_tbl_h)
            sta     BIOSTHL
            lda     #.HIBYTE(bios_tbl_h)
            sta     BIOSTHH
            
            ;- keyboard map address --------------------------------------------
            lda     #.LOBYTE(keymap)
            sta     KEYMAPL
            lda     #.HIBYTE(keymap)
            sta     KEYMAPH
            
            ;- clear keyboard buffer -------------------------------------------
            lda     KBD_RXREG
            
            ;- print headers to the screen -------------------------------------
@headers:   ldx     #.HIBYTE(biosver)
            lda     #.LOBYTE(biosver)
            jsr     puts                ; BIOS header
            
            ldx     #.HIBYTE(copyright)
            lda     #.LOBYTE(copyright)
            jsr     puts                ; copyright
            
            lda     #LF
            jsr     putch
            
            ldx     #.HIBYTE(nodisk)
            lda     #.LOBYTE(nodisk)
            jsr     puts                ; no disk message
            
            ldx     #.HIBYTE(loading)
            lda     #.LOBYTE(loading)
            jsr     puts                ; loading ROM monitor message
            
            ;- transfer to ROM monitor -----------------------------------------
            jmp     monitor             ; ROM monitor program


;===============================================================================
; BIOS CALL ROUTINES
;===============================================================================

.CODE

;= #0 SOFTRST ==================================================================
; Soft reset. Sets/resets the appropriate flags and jumps to the reset vector.
;
; Parameters: none
; Returns:    none

.proc softrst
            
            cld                         ; clear decimal flag
            sei                         ; set interrupt disable flag
            jmp     reset               ; go to reset vector
            
.endproc


;= #1 PUTCH ====================================================================
; Prints a character to the screen. Updates the cursor position after printing.
;
; Parameters: A = character
; Returns:    none
;
; Destroys: X, VRAML, VRAMH
;
; Cycles (jsr->rts): 63-193

.proc putch
            
            cmp     #LF
            beq     @lf                 ; linefeed? process
            cmp     #TAB
            beq     @tab                ; TAB? process
            cmp     #BS
            beq     @bs                 ; backspace? process
            bra     @print              ; print character
            
            ;- process linefeed ------------------------------------------------
@lf:        ldx     #0                  ; column = 0
            lda     ROW                 ; A = row
            inc     A                   ; row++
            cmp     #25
            bne     @setcurs            ; 25? nope
            
            jsr     scrolldn            ; scroll display
            lda     #24                 ; row = 24
            bra     @setcurs
                        
            ;- process TAB -----------------------------------------------------
@tab:       lda     COL                 ; A = column
            cmp     #72
            bcs     @lf                 ; column >= 72? new line
            
            and     #%11111000          ; clear lower three bits of column
            adc     #8                  ; advance to next tab stop (carry clear)
            tax                         ; X = new column
            lda     ROW
            bra     @setcurs
            
            ;- process backspace -----------------------------------------------
@bs:        lda     ROW                 ; A = row
            ldx     COL                 ; X = column
            dex                         ; column--
            bpl     @setcurs            ; bit 7 set? nope, set cursor
            
            ldx     #79                 ; column = 79
            dec     A                   ; row--
            bmi     @exit               ; negative? do nothing
            bra     @setcurs            ; set cursor
            
            ;- write character to screen ---------------------------------------
@print:     tax                         ; save character
            
            lda     VGA_CURSH
            sta     VRAMH
            lda     VGA_CURSL
            sta     VRAML               ; (VRAM) = 11-bit cursor address
            
            asl     VRAML               ; 12-bit VRAM addr = cursor addr << 1
            rol     VRAMH
            lda     VRAMH
            ora     #.HIBYTE(__VRAM_START__)
            sta     VRAMH               ; (VRAM) = 16-bit VRAM address
            
            txa                         ; restore character
            
            sta     (VRAM)              ; write character to screen
            
            ldx     COL                 ; X = current column
            cpx     #79
            beq     @lf                 ; column == 79? newline

            inx                         ; column++
            lda     ROW                 ; A = current row
            
@setcurs:   jsr     gotoxy              ; update cursor position
            
@exit:      rts

.endproc


;= #2 PUTS =====================================================================
; Prints a null terminated string to the screen. Updates the cursor position
; after printing.
;
; Parameters: X = &string<15:8>
;             A = &string<7:0>
; Returns:    none
;
; Destroys: Y, STRL, STRH
;
; Cycles (jsr->rts): 48 - [205 * strlen + 8]

.proc puts
            
            stx     STRH
            sta     STRL                ; (STR) = string address
            
            ldy     #0                  ; Y = string index
@loop:      lda     (STR), Y            ; A = string character
            beq     @exit               ; NUL? exit
            
            jsr     putch
            iny                         ; index++
            bne     @loop               ; next character (256 character limit)
            
@exit:      rts

.endproc


;= #3 GOTOXY ===================================================================
; Moves the cursor to a screen position.
;
; Parameters: X = column
;             A = row
; Returns:    none
;
; Destroys: CURSL, CURSH, CURSTMP
;
; Cycles (jsr->rts): 

.proc gotoxy
            
            stx     COL
            sta     ROW                 ; update stored cursor coordinates
            
            stx     CURSL
            stz     CURSH               ; CURS = column (16-bit)
            stz     CURSTMP             ; CURSTMP,A = row (16-bit)
            
            asl     A
            asl     A
            asl     A
            asl     A                   ; don't have to carry until 4th shift
            rol     CURSTMP             ; CURSTMP,A = row << 4
            pha                         ; push A
            
            clc
            adc     CURSL
            sta     CURSL
            lda     CURSH
            adc     CURSTMP
            sta     CURSH               ; CURS = column + (row << 4)
            
            pla                         ; CURSTMP,A = row << 4
            asl     A
            rol     CURSTMP
            asl     A
            rol     CURSTMP             ; CURSTMP,A = row << 6
            
            ; VGA cursor address = column + (row << 4) + (row << 6)
            ; $0000 = column + (row << 4)
            ; $0002,A = row << 6
            clc
            adc     CURSL
            sta     VGA_CURSL
            lda     CURSH
            adc     CURSTMP
            sta     VGA_CURSH
            
@done:      rts

.endproc


;= #4 SCROLLDN =================================================================
; Scrolls the display down a line.
;
; Parameters: none
; Returns:    none
;
; Destroys: A

.proc scrolldn
        
            lda     #.HIBYTE(__VRAM_START__)
            sta     VRAMH
            lda     #.LOBYTE(__VRAM_START__)
            sta     VRAML               ; (VRAM) = address of (0,0)
            
            lda     #.HIBYTE(__VRAM_START__ + 160)
            sta     SCROLLH
            lda     #.LOBYTE(__VRAM_START__ + 160)
            sta     SCROLLL             ; (SCROLL) = address of (0,1)
            
@loop0:     lda     (SCROLL)            ; save character from line below
            sta     (VRAM)              ; copy to line above
            
            inc     VRAML
            bne     @incscroll          ; VRAML++ rollover to 00? nope
            inc     VRAMH               ; yes, VRAMH++
            
@incscroll: inc     SCROLLL
            bne     @bounds             ; SCROLLL++ rollover to 00? nope
            inc     SCROLLH             ; yes, SCROLLH++
            
            ;- bounds check (SCROLL) against video RAM end ---------------------            
@bounds:    lda     SCROLLH
            cmp     #.HIBYTE(__VRAM_START__ + __VRAM_SIZE__)
            bne     @loop0
            lda     SCROLLL
            cmp     #.LOBYTE(__VRAM_START__ + __VRAM_SIZE__)
            bne     @loop0
            
            ;- clear bottom line -----------------------------------------------
@loop1:     lda     #NUL
            sta     (VRAM)
            inc     VRAML
            lda     #ATTRIB
            sta     (VRAM)
            inc     VRAML
            lda     VRAML
            cmp     #.LOBYTE(__VRAM_START__ + __VRAM_SIZE__)
            bne     @loop1    
            
            rts

.endproc


;= #5 GETKEY ===================================================================
; Wait for keystroke and read.
;
; Parameters: none
; Returns:    X = scan code
;             A = ASCII or zero

.proc getkey
            
            lda     KBD_STATUS          ; retrieve keyboard STATUS register
            bit     #KBD_DRDY           ; test DATA_RDY
            beq     getkey              ; DATA_RDY == 0? keep polling
            
            lda     KBD_STATUS          ; retrieve keyboard STATUS register
            and     #KBD_SHIFT          ; isolate shift bit
            asl     A
            asl     A
            asl     A                   ; STATUS << 3
            ora     KBD_RXREG           ; scan code | (STATUS << 3)
            tax
            lda     keymap, X           ; A = ASCII
            ldx     KBD_RXREG           ; X = scan code
            
            rts

.endproc


;===============================================================================
; INTERRUPTS
;===============================================================================

.CODE

;= NON-MASKABLE INTERRUPT ======================================================

nmi:        rti


;= RESET =======================================================================

reset:      ldx     #$FF                ; X = $FF
            txs                         ; initialize the stack pointer at $01FF
            jmp     bios                ; BIOS entry point


;= IRQ/BRK =====================================================================

irq:        pha                         ; save A
            phx                         ; save X
            
            ;- distinguish between IRQ and BRK ---------------------------------
            tsx                         ; stack pointer -> X
            lda     $0103, X            ; extract status flags
            bit     #%00010000          ; B flag set?
            beq     @exit               ; nope, must be an IRQ
            
            lda     $0105, X            ; stack: program counter high byte
            sta     R1
            lda     $0104, X            ; stack: program counter low byte
            sta     R0                  ; (R0) = program counter return location
            
            ;- extract BRK padding byte for error code -------------------------
            sec
            sbc     #1
            sta     R0
            lda     R1
            sbc     #0
            sta     R1                  ; (R0) = PC - 1 = error code (pad byte)
            
            lda     #$C0                ; display error code on SSEG display
            sta     SSEG_BYTE3
            lda     #$DE
            sta     SSEG_BYTE2
            lda     (R0)                ; padding byte = error code
            sta     SSEG_BYTE0
            lda     #%11110011          ; Bytes 0, 2, and 3 turned on
            sta     SSEG_DIGITS         ; display "C0DE XX" on SSEG (XX = code)
            
@halt:      bra     @halt               ; loop forever
            
@exit:      plx
            pla
            
            rti


;===============================================================================
; INTERRUPT VECTOR TABLE
;===============================================================================

.SEGMENT "VECTORS"

            .WORD nmi                   ; $FFFA
            .WORD reset                 ; $FFFC
            .WORD irq                   ; $FFFE


;===============================================================================
; READ ONLY DATA
;===============================================================================

.RODATA

;= BIOS CALL TABLE =============================================================
; 0 - Soft reset
; 1 - Write character at current cursor
; 2 - Write string at current cursor
; 3 - Set cursor position
; 4 - Scroll screen down one line

bios_tbl_l: .BYTE .LOBYTE(softrst-1)
            .BYTE .LOBYTE(putch-1)
            .BYTE .LOBYTE(puts-1)
            .BYTE .LOBYTE(gotoxy-1)
            .BYTE .LOBYTE(scrolldn-1)
            .BYTE .LOBYTE(getkey-1)

bios_tbl_h: .BYTE .HIBYTE(softrst-1)
            .BYTE .HIBYTE(putch-1)
            .BYTE .HIBYTE(puts-1)
            .BYTE .HIBYTE(gotoxy-1)
            .BYTE .HIBYTE(scrolldn-1)
            .BYTE .HIBYTE(getkey-1)


;= STRINGS =====================================================================

biosver:    .BYTE VERSION, LF, NUL
copyright:  .BYTE "Copyright (C) 2018 Ryan Clarke", LF, NUL
nodisk:     .BYTE "SD card not found.", LF, NUL
loading:    .BYTE "Loading ROM monitor.", LF, NUL


;= KEYBOARD MAP ================================================================

keymap:     .BYTE $00, $00, $00, $00, $00, $00, $00, $00    ; 00-07
            .BYTE $00, $00, $00, $00, $00, $09, $60, $00    ; 08-0F
            .BYTE $00, $00, $00, $00, $00, $71, $31, $00    ; 10-17
            .BYTE $00, $00, $7A, $73, $61, $77, $32, $00    ; 18-1F
            .BYTE $00, $63, $78, $64, $65, $34, $33, $00    ; 20-27
            .BYTE $00, $20, $76, $66, $74, $72, $35, $00    ; 28-2F
            .BYTE $00, $6E, $62, $68, $67, $79, $36, $00    ; 30-37
            .BYTE $00, $00, $6D, $6A, $75, $37, $38, $00    ; 38-3F
            .BYTE $00, $2C, $6B, $69, $6F, $30, $39, $00    ; 40-47
            .BYTE $00, $2E, $2F, $6C, $3B, $70, $2D, $00    ; 48-4F
            .BYTE $00, $00, $27, $00, $5B, $3D, $00, $00    ; 50-57
            .BYTE $00, $00, $0A, $5D, $00, $5C, $00, $00    ; 58-5F
            .BYTE $00, $00, $00, $00, $00, $00, $08, $00    ; 60-67
            .BYTE $00, $00, $00, $00, $00, $00, $00, $00    ; 68-6F
            .BYTE $00, $00, $00, $00, $00, $00, $1B, $00    ; 70-77
            .BYTE $00, $00, $00, $00, $00, $00, $00, $00    ; 78-7F
            .BYTE $00, $00, $00, $00, $00, $00, $00, $00    ; 80-87
            .BYTE $00, $00, $00, $00, $00, $09, $7E, $00    ; 88-8F
            .BYTE $00, $00, $00, $00, $00, $51, $21, $00    ; 90-97
            .BYTE $00, $00, $5A, $53, $41, $57, $40, $00    ; 98-9F
            .BYTE $00, $43, $58, $44, $45, $24, $23, $00    ; A0-A7
            .BYTE $00, $20, $56, $46, $54, $52, $25, $00    ; A8-AF
            .BYTE $00, $4E, $42, $48, $47, $59, $5E, $00    ; B0-B7
            .BYTE $00, $00, $4D, $4A, $55, $26, $2A, $00    ; B8-BF
            .BYTE $00, $3C, $4B, $49, $4F, $29, $28, $00    ; C0-C7
            .BYTE $00, $3E, $3F, $4C, $3A, $50, $5F, $00    ; C8-CF
            .BYTE $00, $00, $22, $00, $7B, $2B, $00, $00    ; D0-D7
            .BYTE $00, $00, $0A, $7D, $00, $7C, $00, $00    ; D8-DF
            .BYTE $00, $00, $00, $00, $00, $00, $08, $00    ; E0-E7
            .BYTE $00, $00, $00, $00, $00, $00, $00, $00    ; E8-EF
            .BYTE $00, $00, $00, $00, $00, $00, $1B, $00    ; F0-F7
            .BYTE $00, $00, $00, $00, $00, $00, $00, $00    ; F8-FF

.END
