; Purpose : BIOS subroutines table for the v65C02 8-bit Computer.
;===============================================================================


.PC02

.IMPORT reset
.IMPORT clrscr
.IMPORT putch
.IMPORT cputs
.IMPORT gotoxy
.IMPORT uart_getc
.IMPORT uart_putc
.IMPORT uart_puts

.EXPORT bios_lo
.EXPORT bios_hi


;= BIOS SUBROUTINES RTS TABLE ==================================================

.RODATA

bios_lo:    .BYTE .LOBYTE(reset-1)
            .BYTE .LOBYTE(clrscr-1)
            .BYTE .LOBYTE(putch-1)
            .BYTE .LOBYTE(cputs-1)
            .BYTE .LOBYTE(gotoxy-1)
            .BYTE .LOBYTE(uart_getc-1)
            .BYTE .LOBYTE(uart_putc-1)
            .BYTE .LOBYTE(uart_puts-1)

bios_hi:    .BYTE .HIBYTE(reset-1)
            .BYTE .HIBYTE(clrscr-1)
            .BYTE .HIBYTE(putch-1)
            .BYTE .HIBYTE(cputs-1)
            .BYTE .HIBYTE(gotoxy-1)
            .BYTE .HIBYTE(uart_getc-1)
            .BYTE .HIBYTE(uart_putc-1)
            .BYTE .HIBYTE(uart_puts-1)
