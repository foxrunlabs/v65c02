;===============================================================================
; Program   : v65C02 BIOS
; File Name : bios.a65
; Project   : v65C02 8-bit Computer
; Author    : Ryan Clarke
; E-mail    : kj6msg@icloud.com
;===============================================================================
; Purpose : BIOS for the v65C02 8-bit computer.
;===============================================================================


.PC02

.INCLUDE    "v65C02.inc"

.IMPORT     __VRAM_START__
.IMPORT     __VRAM_SIZE__

.IMPORT     monitor


;= CONSTANTS ===================================================================

.DEFINE     VERSION .CONCAT("v65C02 BIOS v", "1.0.0a")

            ATTRIB = (BLACK << 4) | LIGHT_GRAY  ; light gray on black


;===============================================================================
; BIOS
;===============================================================================

.CODE

;= ENTRY POINT =================================================================

bios:       stz     VGA_STATUS          ; VGA & cursor off, select display page
            
            lda     #ATTRIB
            sta     ATTR                ; set default attribute
            
            jsr     clrscr              ; clear screen
            
            ;- SSEG initialization ---------------------------------------------
            stz     SSEG_DIGITS
            stz     SSEG_DP
            stz     SSEG_BYTE0
            stz     SSEG_BYTE1
            stz     SSEG_BYTE2
            stz     SSEG_BYTE3
            
            ;- BIOS call table address -----------------------------------------
            lda     #.LOBYTE(bios_tbl_l)
            sta     BIOSTLL
            lda     #.HIBYTE(bios_tbl_l)
            sta     BIOSTLH
            lda     #.LOBYTE(bios_tbl_h)
            sta     BIOSTHL
            lda     #.HIBYTE(bios_tbl_h)
            sta     BIOSTHH
            
            ;- print headers to the screen -------------------------------------
            ldx     #.HIBYTE(biosver)
            lda     #.LOBYTE(biosver)
            jsr     puts                ; BIOS header
            
            ldx     #.HIBYTE(copyright)
            lda     #.LOBYTE(copyright)
            jsr     puts                ; copyright
            
            lda     #LF
            jsr     teletype
            
            ldx     #.HIBYTE(nodisk)
            lda     #.LOBYTE(nodisk)
            jsr     puts                ; no disk message
            
            ldx     #.HIBYTE(loading)
            lda     #.LOBYTE(loading)
            jsr     puts                ; loading ROM monitor message
            
            ;- clear keyboard buffer -------------------------------------------
            lda     KBD_DATA
            
            ;- transfer to ROM monitor -----------------------------------------
            jmp     monitor             ; ROM monitor program


;===============================================================================
; BIOS CALL ROUTINES
;===============================================================================

.CODE

;= #0 SOFT RESET ===============================================================
; Soft reset. Sets/resets the appropriate flags and jumps to the reset vector.
;
; Parameters: none
; Returns:    none

.proc softrst
            
            cld                         ; clear decimal flag
            sei                         ; set interrupt disable flag
            jmp     reset               ; go to reset vector
            
.endproc


;= #1 CLEAR SCREEN =============================================================
; Clear screen with attribute stored in ATTR. Resets cursor to (0,0).
;
; Parameters: none
; Returns:    none
;
; Destroys: A, VRAML, VRAMH

.proc clrscr
            lda     #VGA_EN
            trb     VGA_STATUS          ; turn off display
            
            ;- point VRAM to VRAM start address --------------------------------
            lda     #.HIBYTE(__VRAM_START__)
            sta     VRAMH
            lda     #.LOBYTE(__VRAM_START__)
            sta     VRAML
            
loop0:      lda     #VRAM_PAGE          ; A = VRAM page bit mask
            trb     VRAMH               ; set character page
            
            lda     #NUL                ; A = NUL
            sta     (VRAM)              ; store NUL to VRAM
            
            lda     #VRAM_PAGE          ; A = VRAM page bit mask
            tsb     VRAMH               ; set attribute page
            
            lda     ATTR                ; A = screen attribute
            sta     (VRAM)              ; store attribute to VRAM
            
            inc     VRAML               ; increment VRAM address LSB
            bne     loop0               ; roll over to $00? no, loop
            
            inc     VRAMH               ; increment VRAM address MSB
            lda     VRAMH               ; A = VRAM address MSB
            cmp     #.HIBYTE(__VRAM_START__ + __VRAM_SIZE__)
            bne     loop0               ; equal to VRAM upper limit? no, loop
            
            stz     VGA_CURSH
            stz     VGA_CURSL           ; set cursor to (0,0)
            stz     COL
            stz     ROW                 ; update stored cursor coordinates
            
            lda     #VGA_EN
            tsb     VGA_STATUS          ; turn on display
            
            rts

.endproc


;= #2 SET CURSOR POSITION ======================================================
; Moves the cursor to a screen position.
;
; Parameters: X = column
;             A = row
; Returns:    none
;
; Destroys: CURSL, CURSH, CURSTMP
;
; Cycles (jsr->rts): 

.proc gotoxy
            
            stx     COL
            sta     ROW                 ; update stored cursor coordinates
            
            stx     CURSL
            stz     CURSH               ; CURS = column (16-bit)
            stz     CURSTMP             ; CURSTMP,A = row (16-bit)
            
            asl     A
            asl     A
            asl     A
            asl     A                   ; don't have to carry until 4th shift
            rol     CURSTMP             ; CURSTMP,A = row << 4
            pha                         ; push A
            
            clc
            adc     CURSL
            sta     CURSL
            lda     CURSH
            adc     CURSTMP
            sta     CURSH               ; CURS = column + (row << 4)
            
            pla                         ; CURSTMP,A = row << 4
            asl     A
            rol     CURSTMP
            asl     A
            rol     CURSTMP             ; CURSTMP,A = row << 6
            
            ; VGA cursor address = column + (row << 4) + (row << 6)
            ; $0000 = column + (row << 4)
            ; $0002,A = row << 6
            clc
            adc     CURSL
            sta     VGA_CURSL
            lda     CURSH
            adc     CURSTMP
            sta     VGA_CURSH
            
            rts

.endproc


;= #3 SCROLL UP ================================================================
; Scrolls the display up a line.
;
; Parameters: none
; Returns:    none
;
; Destroys: A

.proc scrollup
        
            lda     #.HIBYTE(__VRAM_START__)
            sta     VRAMH
            lda     #.LOBYTE(__VRAM_START__)
            sta     VRAML               ; (VRAM) = address of (0,0)
            
            lda     #.HIBYTE(__VRAM_START__ + NUMCOLS)
            sta     SCROLLH
            lda     #.LOBYTE(__VRAM_START__ + NUMCOLS)
            sta     SCROLLL             ; (SCROLL) = address of (0,1)
            
loop0:      lda     (SCROLL)            ; save character from line below
            sta     (VRAM)              ; copy to line above
            
            lda     #VRAM_PAGE          ; A = VRAM page bit mask
            tsb     VRAMH               ; set attribute page
            tsb     SCROLLH
            
            lda     (SCROLL)            ; save attribute from line below
            sta     (VRAM)              ; copy to line above
            
            lda     #VRAM_PAGE          ; A = VRAM page bit mask
            trb     VRAMH               ; set display page
            trb     SCROLLH
            
            inc     VRAML
            bne     incscroll           ; VRAML++ rollover to 00? nope
            inc     VRAMH               ; yes, VRAMH++
            
incscroll:  inc     SCROLLL
            bne     bounds              ; SCROLLL++ rollover to 00? nope
            inc     SCROLLH             ; yes, SCROLLH++
            
            ;- bounds check (SCROLL) against screen end ------------------------            
bounds:    lda      SCROLLH
            cmp     #.HIBYTE(__VRAM_START__ + (NUMCOLS * NUMROWS))
            bne     loop0
            lda     SCROLLL
            cmp     #.LOBYTE(__VRAM_START__ + (NUMCOLS * NUMROWS))
            bne     loop0
            
            ;- clear bottom line -----------------------------------------------
loop1:      lda     #NUL                ; A = NUL
            sta     (VRAM)              ; write character to VRAM
            
            lda     #VRAM_PAGE          ; A = VRAM page bit mask
            tsb     VRAMH               ; set attribute page
            
            lda     ATTR                ; A = default attribute
            sta     (VRAM)              ; write attribute to VRAM
            
            lda     #VRAM_PAGE          ; A = VRAM page bit mask
            trb     VRAMH               ; set character page
            
            inc     VRAML
            lda     VRAML
            cmp     #.LOBYTE(__VRAM_START__ + (NUMCOLS * NUMROWS))
            bne     loop1    
            
            rts

.endproc


;= #4 SCROLL DOWN ==============================================================
; Scrolls the display down a line.
;
; Parameters: none
; Returns:    none

.proc scrolldn
            
            rts

.endproc


;= #5 READ ATTRIBUTE/CHARACTER AT CURSOR =======================================
; Reads the attribute and character at the current cursor position.
;
; Parameters: none
; Returns:    none

.proc getchattr
            
            rts

.endproc


;= #6 WRITE ATTRIBUTE/CHARACTER AT CURSOR =======================================
; Write an attribute and raw character at the current cursor position.
;
; Parameters: A    = character
;             ATTR = attribute
; Returns:    none

.proc putchattr
            pha                         ; save character
            
            ;- convert 12-bit cursor address to 16-bit VRAM address
            lda     VGA_CURSH
            ora     #.HIBYTE(__VRAM_START__)
            sta     VRAMH
            lda     VGA_CURSL
            sta     VRAML
            
            lda     #VRAM_PAGE
            tsb     VRAMH               ; set attribute page
            
            lda     ATTR
            sta     (VRAM)              ; write attribute to VRAM
            
            lda     #VRAM_PAGE
            trb     VRAMH               ; set character page
            
            pla                         ; restore character
            jmp     putch               ; write character
            
            rts

.endproc


;= #7 WRITE CHARACTER AT CURSOR ================================================
; Write a raw character at the current cursor position.
;
; Parameters: A    = character
; Returns:    none
;
; Destroys: VRAML, VRAMH

.proc putch
            
            pha                         ; save character
            
            ;- convert 12-bit cursor address to 16-bit VRAM address
            lda     VGA_CURSH
            ora     #.HIBYTE(__VRAM_START__)
            sta     VRAMH
            lda     VGA_CURSL
            sta     VRAML
            
            pla                         ; restore character
            sta     (VRAM)              ; write character to VRAM
            
            rts

.endproc


;= #8 WRITE TELETYPE TO SCREEN =================================================
; Prints a character to the screen at the current cursor position. Updates the
; cursor position after printing. Line feed, backspace, and tab are treated as
; commands.
;
; Also contains PUTCH, which prints a raw character to the screen at the current
; cursor position. Does not update the cursor position after printing.
;
; Parameters: A = character
; Returns:    none
;
; Destroys: X, VRAML, VRAMH
;
; Cycles (jsr->rts):

.proc teletype
            
            cmp     #LF
            beq     lf                  ; line feed? process
            cmp     #HT
            beq     ht                  ; horizontal tab? process
            cmp     #BS
            beq     bs                  ; backspace? process
            bra     print               ; print character
            
            ;- process LF ------------------------------------------------------
lf:         ldx     #0                  ; column = 0
            lda     ROW                 ; A = row
            inc     A                   ; row++
            cmp     #NUMROWS
            bne     setcurs             ; NUMROWS? nope
            
            jsr     scrollup            ; scroll display
            lda     #(NUMROWS - 1)      ; row = NUMROWS - 1
            bra     setcurs
                        
            ;- process HT ----------_-------------------------------------------
ht:         lda     COL                 ; A = column
            cmp     #(NUMCOLS - 8)
            bcs     lf                  ; column >= NUMROWS - 8? new line
            
            and     #%11111000          ; clear lower three bits of column
            adc     #8                  ; advance to next tab stop (carry clear)
            tax                         ; X = new column
            lda     ROW
            bra     setcurs
            
            ;- process BS --------------_---------------------------------------
bs:         lda     ROW                 ; A = row
            ldx     COL                 ; X = column
            dex                         ; column--
            bpl     setcurs             ; bit 7 set? nope, set cursor
            
            ldx     #(NUMCOLS - 1)      ; column = 79
            dec     A                   ; row--
            bmi     exit                ; negative? do nothing
            bra     setcurs             ; set cursor
            
            ;- write character to screen ---------------------------------------
print:      tax                         ; save character
            
            lda     VGA_CURSL
            sta     VRAML               ; (VRAM) = 12-bit cursor address
            lda     VGA_CURSH
            ora     #.HIBYTE(__VRAM_START__)
            sta     VRAMH               ; (VRAM) = 16-bit VRAM address
            
            txa                         ; restore character
            sta     (VRAM)              ; write character to VRAM
            
            lda     #VRAM_PAGE
            tsb     VRAMH               ; set attribute page
            
            lda     ATTR
            sta     (VRAM)              ; write attribute to VRAM
            
            ldx     COL                 ; X = current column
            cpx     #(NUMCOLS - 1)
            beq     lf                  ; column == 79? new line

            inx                         ; column++
            lda     ROW                 ; A = current row
            
setcurs:    jsr     gotoxy              ; update cursor position
            
exit:       rts

.endproc


;= #9 PUTS =====================================================================
; Prints a null terminated string to the screen. Updates the cursor position
; after printing.
;
; Parameters: X = &string<15:8>
;             A = &string<7:0>
; Returns:    none
;
; Destroys: Y, STRL, STRH
;
; Cycles (jsr->rts): 48 - [205 * strlen + 8]

.proc puts
            
            stx     STRH
            sta     STRL                ; (STR) = string address
            
            ldy     #0                  ; Y = string index
loop0:      lda     (STR), Y            ; A = string character
            beq     exit                ; NUL? exit
            
            jsr     teletype
            iny                         ; index++
            bne     loop0               ; next character (256 character limit)
            
exit:       rts

.endproc


;= #10 SEND BYTE ===============================================================
; Sends a byte via the UART.
;
; Parameters: none
; Returns:    none

.proc uarttx
            
            rts

.endproc


;= #11 RECEIVE BYTE ============================================================
; Receive a byte via the UART.
;
; Parameters: none
; Returns:    none

.proc uartrx
            
            rts

.endproc


;= #12 GETKEY ===================================================================
; Wait for keystroke and read.
;
; Parameters: none
; Returns:    A = ASCII code

.proc getkey
            
            lda     KBD_STATUS          ; retrieve keyboard STATUS register
            bit     #KBD_DATAFULL       ; test DATAFULL bit
            beq     getkey              ; FULL == 0? keep polling
            
            lda     KBD_DATA            ; read DATA register
            
            rts

.endproc


;===============================================================================
; INTERRUPTS
;===============================================================================

.CODE

;= NON-MASKABLE INTERRUPT ======================================================

nmi:        rti


;= RESET =======================================================================

reset:      ldx     #$FF                ; X = $FF
            txs                         ; initialize the stack pointer at $01FF
            jmp     bios                ; BIOS entry point


;= IRQ/BRK =====================================================================

irq:        pha                         ; save A
            phx                         ; save X
            
            ;- distinguish between IRQ and BRK ---------------------------------
            tsx                         ; stack pointer -> X
            lda     $0103, X            ; extract status flags
            bit     #%00010000          ; B flag set?
            beq     @irq                ; nope, must be an IRQ
            
            lda     $0105, X            ; stack: program counter high byte
            sta     R1
            lda     $0104, X            ; stack: program counter low byte
            sta     R0                  ; (R0) = program counter return location
            
            ;- calculate BRK address and display on SSEG -----------------------
            sec
            sbc     #2
            sta     R0
            lda     R1
            sbc     #0
            sta     R1                  ; R1,R0 = address of BRK instruction
            
            lda     R1
            sta     SSEG_BYTE1
            lda     R0
            sta     SSEG_BYTE0
            lda     #%00001111          ; bytes 0 and 1 turned on
            sta     SSEG_DIGITS         ; display address of BRK instruction
            
@halt:      bra     @halt               ; loop forever
            
            ;- IRQ handler -----------------------------------------------------
@irq:       plx
            pla
            
            rti


;===============================================================================
; INTERRUPT VECTOR TABLE
;===============================================================================

.SEGMENT "VECTORS"

            .WORD nmi                   ; $FFFA
            .WORD reset                 ; $FFFC
            .WORD irq                   ; $FFFE


;===============================================================================
; READ ONLY DATA
;===============================================================================

.RODATA

;= BIOS CALL TABLE =============================================================

bios_tbl_l: .BYTE .LOBYTE(softrst - 1)
            .BYTE .LOBYTE(clrscr - 1)
            .BYTE .LOBYTE(gotoxy - 1)
            .BYTE .LOBYTE(scrollup - 1)
            .BYTE .LOBYTE(scrolldn - 1)
            .BYTE .LOBYTE(getchattr - 1)
            .BYTE .LOBYTE(putchattr - 1)
            .BYTE .LOBYTE(putch - 1)
            .BYTE .LOBYTE(teletype - 1)
            .BYTE .LOBYTE(puts - 1)
            .BYTE .LOBYTE(uarttx - 1)
            .byte .LOBYTE(uartrx - 1)
            .BYTE .LOBYTE(getkey - 1)

bios_tbl_h: .BYTE .HIBYTE(softrst - 1)
            .BYTE .HIBYTE(clrscr - 1)
            .BYTE .HIBYTE(gotoxy - 1)
            .BYTE .HIBYTE(scrollup - 1)
            .BYTE .HIBYTE(scrolldn - 1)
            .BYTE .HIBYTE(getchattr - 1)
            .BYTE .HIBYTE(putchattr - 1)
            .BYTE .HIBYTE(putch - 1)
            .BYTE .HIBYTE(teletype - 1)
            .BYTE .HIBYTE(puts - 1)
            .BYTE .HIBYTE(uarttx - 1)
            .BYTE .HIBYTE(uartrx - 1)
            .BYTE .HIBYTE(getkey - 1)


;= STRINGS =====================================================================

biosver:    .BYTE VERSION, LF, NUL
copyright:  .BYTE "Copyright (C) 2018-2019 Ryan Clarke", LF, NUL
nodisk:     .BYTE "SD card not found.", LF, NUL
loading:    .BYTE "Loading ROM monitor.", LF, NUL

.END
