;===============================================================================
; Program   : v65C02 BIOS
; File Name : monitor.a65
; Project   : v65C02 8-bit Computer
; Author    : Ryan Clarke
; E-mail    : kj6msg@icloud.com
;===============================================================================
; Purpose : ROM monitor for the v65C02 BIOS.
;===============================================================================


.PC02

.INCLUDE    "bios.inc"

.IMPORT     __VRAM_START__
.IMPORT     __VRAM_SIZE__

.EXPORT     monitor


;= BIOS CALL MACRO =============================================================

.macro      bios    num
            ldy     num
            jsr     bioscall
.endmacro


;= CONSTANTS ===================================================================

            ATTRIB = (BLACK << 4) | LIGHT_GRAY      ; light gray on black text
            CMDMAX = 78                             ; limit to a row of chars


;===============================================================================
; ROM MONITOR
;===============================================================================

;= ENTRY POINT =================================================================

.CODE

monitor:    lda     #VGA_CURS           ; CURS bit mask
            tsb     VGA_STATUS          ; turn cursor on
            
            stz     CMDLN               ; reset command line buffer
            
            stz     ADDRL               ; clear address LSB
            stz     ADDRH               ; clear address MSB
            
            lda     #.HIBYTE(B1562500)
            sta     UART_BRGH
            lda     #.LOBYTE(B1562500)
            sta     UART_BRGL           ; UART 1,562,500 baud
            
            
;= GET COMMAND LINE ============================================================

getcmdln:   lda     #'-'
            bios    #1                  ; print command prompt
            
            ldx     #0                  ; X = string index
            
            ;- get keystroke ---------------------------------------------------
@getkey:    lda     KBD_STATUS          ; retrieve keyboard STATUS register
            bit     #KBD_DRDY           ; test DATA_RDY
            beq     @getkey             ; DATA_RDY == 0? keep polling
            
            lda     KBD_RXREG           ; read the scan code
            tay                         ; Y = index into keyboard map
            
            ;- check shift key -------------------------------------------------
            lda     KBD_STATUS          ; retrieve keyboard STATUS register
            bit     #KBD_SHIFT          ; test SHIFT
            beq     @evalkey            ; set? nope
            
            tya
            ora     #$80                ; shifted, so turn on bit 7
            tay            
            
            ;- evaluate keystroke ----------------------------------------------
@evalkey:   lda     (KEYMAP), Y         ; convert to ASCII
            beq     @getkey             ; NUL? ignore
            cmp     #ESC
            beq     @esc                ; escape key? process
            cmp     #BS
            beq     @bs                 ; backspace key? process
            cmp     #LF
            beq     @lf                 ; line feed? process
            cmp     #TAB
            beq     @getkey             ; tab? ignore
            
            cpx     #CMDMAX
            beq     @getkey             ; ignore if input > command line maximum
            
            sta     CMDLN, X            ; write character to command string
            inx                         ; next string position
            
            phx                         ; save string index
            bios    #1                  ; print character to screen
            plx                         ; restore string index
            
            bra     @getkey             ; keep getting characters
            
            ;- escape key ------------------------------------------------------
@esc:       jsr     clrln               ; clear current line
            bra     getcmdln            ; new prompt
            
            ;- backspace key ---------------------------------------------------
@bs:        cpx     #0
            beq     @getkey             ; empty line? get more characters
            
            dex                         ; decrement string index
            
            phx                         ; save string index
            bios    #1                  ; write backspace to screen
            lda     #NUL
            bios    #1                  ; write NUL to screen
            lda     #BS
            bios    #1                  ; reset cursor with backspace
            plx                         ; restore string index
            
            bra     @getkey             ; keep getting characters
                
            ;- enter key -------------------------------------------------------
@lf:        stz     CMDLN, X            ; add NUL terminator
            
            phx
            bios    #1                  ; print LF
            plx
            
            
;= PARSE COMMAND LINE ==========================================================
            
parsecmdln: lda     CMDLN               ; A = first character of command line
            beq     getcmdln            ; NUL? get another command line
            cmp     #'g'
            beq     @go                 ; g? go
            cmp     #'?'
            beq     @help               ; help? help
            cmp     #'x'
            beq     @xmodem             ; x? xmodem
            
            stz     R0                  ; R1,R0 will be temporary address
            stz     R1
            
            ;- convert ASCII character to hexadecimal --------------------------
            ldx     #0                  ; X = command line string index
@convaddr:  inx                         ; ++X
            lda     CMDLN, X            ; A = command line character
            beq     @chkaddr            ; NUL? check address
                        
            eor     #'0'                ; map digits to 0-9
            cmp     #10                 ; check if within 0-9
            bcc     @shift              ; 0-9? valid
            
            ora     #$20                ; convert lower to upper case
            adc     #$88                ; map "A"-"F" to $FA-FF
            cmp     #$FA                ; check if within $FA-FF
            bcc     @invalid            ; less than $FA? invalid
            and     #$0F                ; convert to $0A-$0F
            
            ;- shift and OR into temporary location R1,R0 ----------------------
@shift:     asl     R0
            rol     R1
            asl     R0
            rol     R1
            asl     R0
            rol     R1
            asl     R0
            rol     R1                  ; R1,R0 << 4
            
            ora     R0                  ; R1,R0 | A
            sta     R0
            bra     @convaddr           ; keep converting
            
            ;- check if address entered ----------------------------------------
@chkaddr:   cpx     #1
            beq     @evalcmd            ; no address entered? evaluate command
            
            ;- save parsed address ---------------------------------------------
            lda     R0
            sta     ADDRL
            lda     R1
            sta     ADDRH               ; ADDR = R1,R0
            
            ;- evaluate command ------------------------------------------------
@evalcmd:   lda     CMDLN               ; A = first character of command line
            cmp     #'$'
            beq     @dump               ; $? dump
            cmp     #'='
            beq     @enter              ; =? enter
            
            ;- invalid command -------------------------------------------------
@invalid:   ldx     #.HIBYTE(invalidmsg)
            lda     #.LOBYTE(invalidmsg)
            bios    #2                  ; invalid command
            
            jmp     getcmdln            ; go get another one command line
            
            
;===============================================================================
; ROM MONITOR COMMAND ROUTINES
;===============================================================================

.CODE

;= JUMP TABLE ==================================================================
            
@dump:      jmp     dump
@enter:     jmp     enter
@go:        jmp     go
@help:      jmp     help
@xmodem:    jmp     xmodem
            
            
;= DUMP ========================================================================
; Dump 16 bytes of data to the screen from a specified address. Automatically
; increment the stored address by 16 after complete.
            
dump:       ;- save snapshot of memory -----------------------------------------
            ldy     #15
@buffer:    lda     (ADDR), Y
            sta     BUF, Y
            dey
            bpl     @buffer
            
            ;- print address ---------------------------------------------------
            lda     ADDRH               ; MSB first
            jsr     printhex            ; print to screen
            
            lda     ADDRL               ; LSB next
            jsr     printhex            ; print to screen
            
            lda     #':'
            bios    #1                  ; print ':'
            lda     #' '
            bios    #1                  ; print ' '
            
            ;- print bytes -----------------------------------------------------
            ldy     #0                  ; Y = offset
@bytes:     lda     BUF, Y              ; A = data
            
            phy
            jsr     printhex
            lda     #' '
            bios    #1                  ; print space
            ply                         ; reset offset
            
            iny                         ; offset++
            cpy     #16
            bne     @bytes              ; offset == 16? no, keep printing
            
            ;- print ASCII representation --------------------------------------
            lda     #'['
            bios    #1                  ; print '['
            
            ldy     #0                  ; Y = offset
@ascii:     lda     BUF, Y              ; A = byte
            
            cmp     #' '
            bcc     @noprint            ; byte < ' '? non-printable
            cmp     #DEL
            bcc     @print              ; byte < DEL? printable
            
@noprint:   lda     #'.'                ; non-printable characters as '.'
            
@print:     phy                         ; save offset
            bios    #1                  ; print ASCII representation
            ply                         ; restore offset
            
            iny                         ; offset++
            cpy     #16
            bne     @ascii              ; offset == 16? nope, keep doing it
            
            lda     #']'
            bios    #1                  ; print ']'
            
            lda     #LF
            bios    #1                  ; line feed
            
            ;- incremement address ---------------------------------------------
            lda     ADDRL
            clc
            adc     #16
            sta     ADDRL
            lda     ADDRH
            adc     #0
            sta     ADDRH               ; ADDR = ADDR + 16
            
            jmp     getcmdln
            
            
;= ENTER =======================================================================
; Writes a byte at a specified address.
            
enter:      jmp     getcmdln
            
            
;= GO ==========================================================================
; Executes code at $0300 and then resets monitor.
            
.proc go
            
            jsr     $0300               ; execute at $0300
            
            jmp     monitor             ; reset monitor
            
.endproc
            
            
;= HELP ========================================================================
; Prints help message.
            
help:       ldx     #.HIBYTE(helpmsg)
            lda     #.LOBYTE(helpmsg)
            bios    #2
            
            jmp     getcmdln
            
            
;= XMODEM ======================================================================
; Receives a file from the UART via the XMODEM protocol and stores it at $0300.
            
xmodem:     lda     #1                      ; first block = 1
            sta     XBLOCK
            stz     XCHKSUM
            
            lda     #$03
            sta     XDATAH
            stz     XDATAL                  ; (XDATA) points to $0300
            
            ;- purge the UART RXREG for one second -----------------------------
            lda     #$80
            sta     TMR_TIMER08
            lda     #$F0
            sta     TMR_TIMER16
            lda     #$FA
            sta     TMR_TIMER24
            lda     #$02
            sta     TMR_TIMER32             ; Timer set for 1 second
            
@purge:     lda     UART_RXREG              ; clear RXREG
            lda     TMR_STATUS              ; read timer STATUS register
            bit     #TMR_OVRFL              ; test OVRFL flag
            beq     @purge                  ; OVRFL == 0? loop
            
            ;- start reception -------------------------------------------------
            lda     #NAK
            jsr     uart_write              ; send NAK to trigger sender
            
@start:     jsr     uart_read               ; RX with 1 second timeout
            ldx     XERROR                  ; load error code
            beq     @evalbyte               ; received? evaluate
            jmp     @timeout                ; timeout? timeout
            
            ;- evaluate RX byte ------------------------------------------------
@evalbyte:  cmp     #EOT
            beq     @eot                    ; <EOT>? end recv
            cmp     #SOH
            beq     @getblk1                ; <SOH>? get block number
            jmp     @fail                   ; else, we failed
            
            ;- get block number ------------------------------------------------
@getblk1:   jsr     uart_read               ; RX with 1 second timeout
            ldx     XERROR                  ; load error code
            beq     @evalblk1               ; received? evaluate block
            jmp     @fail                   ; timeout? failure
            
            ;- evaluate block number -------------------------------------------
@evalblk1:  cmp     XBLOCK                  ; compare with expected block #
            beq     @getblk2                ; equal? get block number 2
            jmp     @fail                   ; not equal? failure                    
            
            ;- get inverted block ----------------------------------------------
@getblk2:   jsr     uart_read               ; RX with 1 second timeout
            ldx     XERROR                  ; load error code
            beq     @getdata                ; received? get data
            jmp     @fail                   ; timeout? fail
            
            ;- receive block (128 bytes) of data -------------------------------
@getdata:   ldy     #0                      ; Y = byte counter          
@dataloop:  jsr     uart_read               ; RX with 1 second timeout
            ldx     XERROR                  ; load error code
            bne     @fail                   ; timeout? failure
            
            sta     (XDATA), Y              ; write data memory
            
            clc
            adc     XCHKSUM
            sta     XCHKSUM                 ; checksum += data (no carry)
            
            iny                             ; byte counter++
            bpl     @dataloop               ; counter < 128? keep getting data
            
            ;- increment XDATA by 128 bytes (one block) ------------------------
            clc
            lda     XDATAL
            adc     #128
            sta     XDATAL
            lda     XDATAH
            adc     #0
            sta     XDATAH                  ; XDATA += 128
            
            ;- get and evaluate checksum ---------------------------------------
@chksum:    jsr     uart_read               ; RX with 1 second timeout
            ldx     XERROR                  ; load error code
            bne     @fail                   ; timeout? fail
            
            cmp     XCHKSUM                 ; compare with computed checksum
            bne     @fail                   ; not equal? failure
            
            ;- acknowledge reception -------------------------------------------
            lda     #ACK
            jsr     uart_write              ; send <ACK>
            
            inc     XBLOCK                  ; increment block
            stz     XCHKSUM                 ; reset checksum
            
            bra     @start                  ; wait for another block
            
            ;- acknowledge EOT -------------------------------------------------
@eot:       lda     #ACK
            jsr     uart_write              ; send <ACK>
            
            ;- completion message ----------------------------------------------         
            ldx     #.HIBYTE(wrotemsg)
            lda     #.LOBYTE(wrotemsg)
            bios    #2                      ; wrote message
            
            lda     #$03           
            jsr     printhex
            lda     #$00
            jsr     printhex                ; print 0300 to screen
            
            lda     #'-'
            bios    #1
            
            sec
            lda     XDATAL
            sbc     #1
            sta     XDATAL
            lda     XDATAH
            sbc     #0
            sta     XDATAH                  ; subtract one off XDATA
            
            lda     XDATAH            
            jsr     printhex
            lda     XDATAL
            jsr     printhex                ; print XDATA - 1 to screen
            
            lda     #LF
            bios    #1
            
@exit:      jmp     getcmdln                ; get new command line
            
            ;- timeout message -------------------------------------------------
@timeout:   ldx     #.HIBYTE(timeoutmsg)
            lda     #.LOBYTE(timeoutmsg)
            bios    #2                      ; timeout string
            
            bra     @exit                   ; done

            ;- failure message -------------------------------------------------
@fail:      ldx     #.HIBYTE(failmsg)
            lda     #.LOBYTE(failmsg)
            bios    #2                      ; failed string
            
            bra     @exit                   ; done
            
            
;===============================================================================
; SUBROUTINES
;===============================================================================

.CODE

;= BIOSCALL ====================================================================
; Calls a BIOS routine.
;
; Parameters: Y = BIOS call number
;             X = parameter 1 (for two parameter calls)
;             A = parameter 2 (parameter 1 for single parameter calls)
; Returns:    varies with routine
;
; Destroys:   R0

.proc bioscall
            
            sta     R0                  ; save parameter 2
            
            lda     (BIOSTH), Y         ; push high byte 1st
            pha
            lda     (BIOSTL), Y         ; push low byte 2nd (popped 1st on RTS)
            pha
            
            lda     R0                  ; restore parameter 2
                        
            rts                         ; jump to BIOS sub-routine

.endproc


;= CLRLN =======================================================================
; Clear a line with NUL characters. Reset cursor to beginning of line.
;
; Parameters: none
; Returns:    none
;
; Destroys: A, X, Y, VRAML, VRAMH
;
; Cycles (jsr->rts):

.proc clrln
            
            ldx     #0
            lda     ROW
            bios    #3                  ; set cursor to (0,ROW)
            
            lda     VGA_CURSH
            sta     VRAMH
            lda     VGA_CURSL
            sta     VRAML               ; (VRAM) = 11-bit cursor address
            
            asl     VRAML               ; 12-bit VRAM addr = cursor addr << 1
            rol     VRAMH               ; A = $0001 << 1
            lda     VRAMH
            ora     #.HIBYTE(__VRAM_START__)
            sta     VRAMH               ; (VRAM) = 16-bit VRAM address
            
            ldy     #0                  ; Y = offset
@loop:      lda     #NUL                ; A = NUL
            sta     (VRAM), Y           ; (VRAM) = NUL
            iny                         ; Y++
            lda     ATTR                ; A = attribute
            sta     (VRAM), Y           ; (VRAM) = attribute
            iny                         ; Y++
            cpy     #160
            bne     @loop               ; Y == 160? nope, keep clearing
            
            rts

.endproc


;= PRINTHEX ====================================================================
; Prints an 8-bit byte in hexadecimal format to the screen.
;
; Parameters: A = byte
; Returns:    nothing
;
; Destroys: X, Y

.proc printhex
            pha                         ; save byte
            
            sed                         ; decimal mode
            lsr     A
            lsr     A
            lsr     A
            lsr     A                   ; upper nibble
            cmp     #$0A                ; set carry if A >= $0A
            adc     #$30                ; BCD add to convert to ASCII
            cld                         ; set binary mode
            bios    #1                  ; print to screen
            
            pla                         ; restore byte
            sed                         ; decimal mode
            and     #$0F                ; lower nibble
            cmp     #$0A                ; set carry if A >= $0A
            adc     #$30                ; BCD add to convert to ASCII
            cld                         ; binary mode
            bios    #1                  ; print to screen
            
            rts

.endproc


;= UART_READ ===================================================================
; Reads a byte from the UART. Blocks for one second.
;
; Parameters: none
; Returns:    A = byte
;
; Destroys:   A, XERROR

.proc uart_read
            
            stz     XERROR                  ; reset error code
            
            lda     #$80
            sta     TMR_TIMER08
            lda     #$F0
            sta     TMR_TIMER16
            lda     #$FA
            sta     TMR_TIMER24
            lda     #$02
            sta     TMR_TIMER32             ; set timer for 1 second
            
@loop:      lda     UART_STATUS             ; read UART STATUS register
            bit     #UART_RXFULL            ; check RXFULL flag
            bne     @done                   ; RXFULL == 0? check timer
            
            lda     TMR_STATUS              ; read timer STATUS register
            bit     #%00000001              ; check OVRFL flag
            beq     @loop                   ; OVRFL flag == 0? loop
            
            inc     XERROR                  ; time out
            
@done:      lda     UART_RXREG              ; read UART data
            
            rts

.endproc


;= UART_WRITE ==================================================================
; Sends a byte to the UART.
;
; Parameters: A = byte
; Returns:    none
;
; Cycles (jsr->rts): 30 (assumes not busy)

.proc uart_write
            
            pha                     ; save character
            
@busy:      lda     UART_STATUS     ; read UART STATUS register
            bit     #UART_TXBUSY    ; test TXBUSY flag
            bne     @busy           ; TXBUSY == 1?
            
            pla                     ; restore character
            sta     UART_TXREG      ; send it to UART
            
            rts

.endproc


;===============================================================================
; READ ONLY DATA
;===============================================================================

.RODATA

;= STRINGS =====================================================================

invalidmsg: .BYTE "invalid", LF, NUL

helpmsg:    .BYTE "dump", TAB, "$[address]", LF
            .BYTE "enter", TAB, "=[address]", LF
            .BYTE "go", TAB, "g", LF
            .BYTE "help", TAB, "?", LF
            .BYTE "xmodem", TAB, "x", LF, NUL

wrotemsg:   .BYTE "received ", NUL
timeoutmsg: .BYTE "timeout", LF, NUL
failmsg:    .BYTE "failed", LF, NUL


.END
