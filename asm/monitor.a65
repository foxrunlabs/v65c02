;===============================================================================
; Program   : v65C02 BIOS
; File Name : monitor.a65
; Project   : v65C02 8-bit Computer
; Author    : Ryan Clarke
; E-mail    : kj6msg@icloud.com
;===============================================================================
; Purpose : ROM monitor for the v65C02 BIOS.
;===============================================================================


.PC02

.INCLUDE    "bios.inc"

.IMPORT     __VRAM_START__
.IMPORT     __VRAM_SIZE__

.EXPORT     monitor


;= BIOS CALL MACRO =============================================================

.macro      bios    num
            ldy     num
            jsr     bioscall
.endmacro


;= CONSTANTS ===================================================================

            ATTRIB = (BLACK << 4) | LIGHT_GRAY      ; light gray on black text
            CMDMAX = 78                             ; limit input to one line


;===============================================================================
; ROM MONITOR
;===============================================================================

;= ENTRY POINT =================================================================

.CODE

monitor:    lda     #VGA_CURS           ; CURS bit mask
            tsb     VGA_STATUS          ; turn cursor on
            
            stz     CMDLN               ; reset command line buffer
            
            stz     ADDRL               ; clear address LSB
            stz     ADDRH               ; clear address MSB
            
            lda     #.HIBYTE(B1562500)
            sta     UART_BRGH
            lda     #.LOBYTE(B1562500)
            sta     UART_BRGL           ; UART 1,562,500 baud
            
            
;= GET COMMAND LINE ============================================================

getcmdln:   lda     #'-'
            bios    #1                  ; print command prompt
            
            ldx     #0                  ; X = string index
            
            ;- get keystroke ---------------------------------------------------
@getkey:    lda     KBD_STATUS          ; retrieve keyboard STATUS register
            bit     #KBD_DRDY           ; test DATA_RDY
            beq     @getkey             ; DATA_RDY == 0? keep polling
            
            lda     KBD_RXREG           ; read the scan code
            tay                         ; Y = index into keyboard map
            
            ;- check shift key -------------------------------------------------
            lda     KBD_STATUS          ; retrieve keyboard STATUS register
            bit     #KBD_SHIFT          ; test SHIFT
            beq     @evalkey            ; set? nope
            
            tya
            ora     #$80                ; shifted, so turn on bit 7
            tay            
            
            ;- evaluate keystroke ----------------------------------------------
@evalkey:   lda     (KEYMAP), Y         ; convert to ASCII
            beq     @getkey             ; NUL? ignore
            cmp     #ESC
            beq     @esc                ; escape key? process
            cmp     #BS
            beq     @bs                 ; backspace key? process
            cmp     #LF
            beq     @lf                 ; line feed? process
            
            cpx     #CMDMAX
            beq     @getkey             ; ignore if input > command line maximum
            
            sta     CMDLN, X            ; write character to command string
            inx                         ; next string position
            
            phx                         ; save string index
            bios    #1                  ; print character to screen
            plx                         ; restore string index
            
            bra     @getkey             ; keep getting characters
            
            ;- escape key ------------------------------------------------------
@esc:       jsr     clrln               ; clear current line
            bra     getcmdln            ; new prompt
            
            ;- backspace key ---------------------------------------------------
@bs:        cpx     #0
            beq     @getkey             ; empty line? get more characters
            
            dex                         ; decrement string index
            
            phx                         ; save string index
            bios    #1                  ; write backspace to screen
            lda     #NUL
            bios    #1                  ; write NUL to screen
            lda     #BS
            bios    #1                  ; reset cursor with backspace
            plx                         ; restore string index
            
            bra     @getkey             ; keep getting characters
                
            ;- enter key -------------------------------------------------------
@lf:        stz     CMDLN, X            ; add NUL terminator
            
            phx
            bios    #1                  ; print LF
            plx
            
            
;= PARSE COMMAND LINE ==========================================================
            
parsecmdln: cpx     #0                  ; X = string offset
            beq     getcmdln            ; empty? done
            
            lda     CMDLN               ; A = first character of command line
            cmp     #'?'
            bne     @nothelp            ; ?? nope, not help
            jmp     @help               ; it is help, execute
            
@nothelp:   stz     R0                  ; R1,R0 will be temporary address
            stz     R1
            
            ;- convert ASCII character to hexadecimal --------------------------
            ldx     #0                  ; X = command line string index
@getaddr:   inx                         ; ++X
            lda     CMDLN, X            ; A = command line character
            beq     @chkaddr            ; NUL? check address
            cmp     #' '
            beq     @chkaddr            ; space? check address
            cpx     #5
            beq     @invalid            ; address larger than 4 chars? invalid
            
            eor     #'0'                ; map digits to 0-9
            cmp     #10                 ; check if within 0-9
            bcc     @shift              ; 0-9? valid
            
            ora     #$20                ; convert lower to upper case
            adc     #$88                ; map "A"-"F" to $FA-FF
            cmp     #$FA                ; check if within $FA-FF
            bcc     @invalid            ; less than $FA? invalid
            and     #$0F                ; convert to $0A-$0F
            
            ;- shift and OR into temporary location R1,R0 ----------------------
@shift:     asl     R0
            rol     R1
            asl     R0
            rol     R1
            asl     R0
            rol     R1
            asl     R0
            rol     R1                  ; R1,R0 << 4
            
            ora     R0                  ; R1,R0 | A
            sta     R0
            bra     @getaddr            ; keep parsing
            
            ;- check if address entered ----------------------------------------
@chkaddr:   cpx     #1
            bne     @saveaddr           ; X == 1? nope, valid address
            lda     CMDLN
            cmp     #'$'
            beq     @dump               ; X == 1 & command '$'? dump
            bra     @invalid            ; X == 1 & not dump? invalid
            
            ;- save parsed address ---------------------------------------------
@saveaddr:  lda     R0
            sta     ADDRL
            lda     R1
            sta     ADDRH               ; ADDR = R1,R0
            
            ;- evaluate command ------------------------------------------------
@evalcmd:   lda     CMDLN               ; A = first character of command line
            cmp     #'$'
            beq     @dump               ; $? dump
            cmp     #'='
            beq     @enter              ; =? enter
            cmp     #'@'
            beq     @go                 ; @? go
            cmp     #'>'
            beq     @xmodem             ; >? xmodem
            
            ;- invalid command -------------------------------------------------
@invalid:   ldx     #.HIBYTE(invcmd)
            lda     #.LOBYTE(invcmd)
            bios    #2                  ; invalid command
            
            jmp     getcmdln            ; go get another one command line
            
            
;===============================================================================
; ROM MONITOR COMMAND ROUTINES
;===============================================================================

.CODE

;= JUMP TABLE ==================================================================
            
@dump:      jmp     dump
@enter:     jmp     enter
@go:        jsr     go                  ; RTS trick
            jmp     monitor             ; reset monitor
@help:      jmp     help
@xmodem:    jmp     xmodem
            
            
;= DUMP ========================================================================
; Dump 16 bytes of data to the screen from a specified address. Automatically
; increment the stored address by 16 after complete.
            
dump:       ;- save snapshot of memory -----------------------------------------
            ldy     #15
@buffer:    lda     (ADDR), Y
            sta     BUF, Y
            dey
            bpl     @buffer
            
            ;- print address ---------------------------------------------------
            lda     ADDRH               ; MSB first
            jsr     printhex            ; print to screen
            
            lda     ADDRL               ; LSB next
            jsr     printhex            ; print to screen
            
            lda     #':'
            bios    #1                  ; print ':'
            lda     #' '
            bios    #1                  ; print ' '
            
            ;- print bytes -----------------------------------------------------
            ldy     #0                  ; Y = offset
@bytes:     lda     BUF, Y              ; A = data
            
            phy
            jsr     printhex
            lda     #' '
            bios    #1                  ; print space
            ply                         ; reset offset
            
            iny                         ; offset++
            cpy     #16
            bne     @bytes              ; offset == 16? no, keep printing
            
            ;- print ASCII representation --------------------------------------
            lda     #'['
            bios    #1                  ; print '['
            
            ldy     #0                  ; Y = offset
@ascii:     lda     BUF, Y              ; A = byte
            
            cmp     #' '
            bcc     @noprint            ; byte < ' '? non-printable
            cmp     #DEL
            bcc     @print              ; byte < DEL? printable
            
@noprint:   lda     #'.'                ; non-printable characters as '.'
            
@print:     phy                         ; save offset
            bios    #1                  ; print ASCII representation
            ply                         ; restore offset
            
            iny                         ; offset++
            cpy     #16
            bne     @ascii              ; offset == 16? nope, keep doing it
            
            lda     #']'
            bios    #1                  ; print ']'
            
            lda     #LF
            bios    #1                  ; line feed
            
            ;- incremement address ---------------------------------------------
            lda     ADDRL
            clc
            adc     #16
            sta     ADDRL
            lda     ADDRH
            adc     #0
            sta     ADDRH               ; ADDR = ADDR + 16
            
            jmp     getcmdln
            
            
;= ENTER =======================================================================
; Writes a list of bytes starting at a specified address.
            
enter:      lda     CMDLN, X
            beq     @single
            
            
@single:    ;- print address ---------------------------------------------------
            lda     ADDRH               ; MSB first
            jsr     printhex            ; print to screen
            
            lda     ADDRL               ; LSB next
            jsr     printhex            ; print to screen
            
            lda     #':'
            bios    #1                  ; print ':'
            lda     #' '
            bios    #1                  ; print ' '
            
            lda     (ADDR)
            jsr     printhex            ; print to screen
            
            lda     #'.'
            bios    #1
            
            jmp     getcmdln
            
            
;= GO ==========================================================================
; Executes code at a specified address using the RTS trick.
            
.proc go
            
            ;- subtract 1 from ADDR for the RTS trick --------------------------
            sec
            lda     ADDRL
            sbc     #1
            sta     ADDRL
            lda     ADDRH
            sbc     #0
            sta     ADDRH               ; ADDR--
            
            ;- RTS trick -------------------------------------------------------
            lda     ADDRH               ; push high byte 1st
            pha
            lda     ADDRL               ; push low byte 2nd (popped 1st on RTS)
            pha
            rts                         ; jump to (ADDR)
            
.endproc
            
            
;= HELP ========================================================================
; Prints help message.
            
help:       ldx     #.HIBYTE(helpmsg)
            lda     #.LOBYTE(helpmsg)
            bios    #2
            
            jmp     getcmdln
            
            
;= XMODEM ======================================================================
; Receives a file from the UART via the XMODEM protocol and stores it at a
; specified address.
            
xmodem:     lda     #1                      ; first block = 1
            sta     XBLOCK
            stz     XCHKSUM
            
            lda     ADDRH
            sta     XDATAH
            lda     ADDRL
            sta     XDATAL                  ; (DATA) = RAM address
            
            jsr     purge                   ; purge the UART receiver
            
            lda     #NAK
            jsr     uart_putc               ; send NAK to trigger sender
            
@start:     jsr     u_getc_1s               ; RX with 1 second timeout
            ldx     XERROR                  ; load error code
            beq     @cont                   ; no error, start the process
            jmp     @timeout                ; error > 0? timeout
            
@cont:      lda     UART_RXREG              ; get data from UART
            cmp     #EOT                    ; compared with <EOT>
            beq     @end                    ; data == <EOT>? end recv
            cmp     #SOH                    ; compared with <SOH>
            beq     @block                  ; data == <SOH>? get block #
            jmp     @fail                   ; else, we failed

@block:     jsr     u_getc_1s               ; RX with 1 second timeout
            ldx     XERROR                  ; load error code
            bne     @timeout                ; error > 0? timeout
            
            lda     UART_RXREG              ; read UART data
            cmp     XBLOCK                  ; compare with expected block #
            beq     @block2
            jmp     @fail                   ; data != expected block, failure         
            
@block2:    jsr     u_getc_1s               ; RX with 1 second timeout
            ldx     XERROR                  ; load error code
            bne     @timeout                ; error > 0? timeout
            
            lda     UART_RXREG              ; read UART data to clear it
            
            ldy     #128                    ; 128 bytes of data per block            
@data:      jsr     u_getc_1s               ; RX with 1 second timeout
            ldx     XERROR                  ; load error code
            bne     @timeout                ; error > 0? timeout
            
            lda     UART_RXREG              ; read UART data
            sta     (XDATA)                 ; store to RAM
            
            clc
            adc     XCHKSUM
            sta     XCHKSUM                 ; checksum += data (no carry)
            
            lda     XDATAL
            clc
            adc     #$01
            sta     XDATAL
            lda     XDATAH
            adc     #$00
            sta     XDATAH                  ; increment 16-bit addr at DATA
            
            dey                             ; byte counter--
            bne     @data                   ; counter > 0? keep getting data
            
            lda     XDATAH                  ; load RAM address MSB
            cmp     #$80                    ; are we outside user RAM?
            beq     @toolarge               ; we are, failure
            
@chksum:    jsr     u_getc_1s               ; RX with 1 second timeout
            ldx     XERROR                  ; load error code
            bne     @timeout                ; error > 0? timeout
            
            lda     UART_RXREG              ; read UART data
            cmp     XCHKSUM                 ; compare with computed checksum
            bne     @fail                   ; not equal? failure
            
            lda     #ACK
            jsr     uart_putc               ; send <ACK>
            inc     XBLOCK                  ; increment block
            stz     XCHKSUM                 ; reset checksum
            
            bra     @start                  ; wait for another block

@end:       lda     #ACK
            jsr     uart_putc               ; send <ACK>
            
            lda     #'$'
            bios #1
            
            lda     #$00
            dec     XBLOCK                  ; adjust blocks received by -1
            lsr     XBLOCK                  ; divide by 2 (blocks-- in MSB)
            ldx     XBLOCK                  ; save MSB to X
            ror     A                       ; 16-bit division by two (X,A)
            
            jsr     printhex                ; print to screen
            
            ldx     #.HIBYTE(complete_msg)
            lda     #.LOBYTE(complete_msg)
            bios    #2                      ; complete string
            bra     @done
            
@timeout:   ldx     #.HIBYTE(timeout_msg)
            lda     #.LOBYTE(timeout_msg)
            bios    #2                      ; timeout string
            bra     @done                   ; done

@toolarge:  ldx     #.HIBYTE(toolarge_msg)
            lda     #.LOBYTE(toolarge_msg)
            bios    #2                      ; file too large string
            bra     @done                   ; done

@fail:      ldx     #.HIBYTE(fail_msg)
            lda     #.LOBYTE(fail_msg)
            bios    #2                      ; failed string
            
@done:      jmp     getcmdln
            
            
;===============================================================================
; SUBROUTINES
;===============================================================================

.CODE

;= BIOSCALL ====================================================================
; Calls a BIOS routine.
;
; Parameters: Y = BIOS call number
;             X = parameter 1 (for two parameter calls)
;             A = parameter 2 (parameter 1 for single parameter calls)
; Returns:    varies with routine
;
; Destroys:   R0

.proc bioscall
            
            sta     R0                  ; save parameter 2
            
            lda     (BIOSTH), Y         ; push high byte 1st
            pha
            lda     (BIOSTL), Y         ; push low byte 2nd (popped 1st on RTS)
            pha
            
            lda     R0                  ; restore parameter 2
                        
            rts                         ; jump to BIOS sub-routine

.endproc


;= CLRLN =======================================================================
; Clear a line with NUL characters. Reset cursor to beginning of line.
;
; Parameters: none
; Returns:    none
;
; Destroys: A, X, Y, VRAML, VRAMH
;
; Cycles (jsr->rts):

.proc clrln
            
            ldx     #0
            lda     ROW
            bios    #3                  ; set cursor to (0,ROW)
            
            lda     VGA_CURSH
            sta     VRAMH
            lda     VGA_CURSL
            sta     VRAML               ; (VRAM) = 11-bit cursor address
            
            asl     VRAML               ; 12-bit VRAM addr = cursor addr << 1
            rol     VRAMH               ; A = $0001 << 1
            lda     VRAMH
            ora     #.HIBYTE(__VRAM_START__)
            sta     VRAMH               ; (VRAM) = 16-bit VRAM address
            
            ldy     #0                  ; Y = offset
@loop:      lda     #NUL                ; A = NUL
            sta     (VRAM), Y           ; (VRAM) = NUL
            iny                         ; Y++
            lda     ATTR                ; A = attribute
            sta     (VRAM), Y           ; (VRAM) = attribute
            iny                         ; Y++
            cpy     #160
            bne     @loop               ; Y == 160? nope, keep clearing
            
            rts

.endproc


;= PRINTHEX ====================================================================
; Prints an 8-bit byte in hexadecimal format to the screen.
;
; Parameters: A = byte
; Returns:    nothing
;
; Destroys: X, Y

.proc printhex
            pha                         ; save byte
            
            sed                         ; decimal mode
            lsr     A
            lsr     A
            lsr     A
            lsr     A                   ; upper nibble
            cmp     #$0A                ; set carry if A >= $0A
            adc     #$30                ; BCD add to convert to ASCII
            cld                         ; set binary mode
            bios    #1                  ; print to screen
            
            pla                         ; restore byte
            sed                         ; decimal mode
            and     #$0F                ; lower nibble
            cmp     #$0A                ; set carry if A >= $0A
            adc     #$30                ; BCD add to convert to ASCII
            cld                         ; binary mode
            bios    #1                  ; print to screen
            
            rts

.endproc


;= PURGE =======================================================================
; Purges the UART input buffer.
;
; Parameters: none
; Returns:    none
;
; Destroys:   A

.proc purge
            
            lda     #$80
            sta     TMR_TIMER08
            lda     #$F0
            sta     TMR_TIMER16
            lda     #$FA
            sta     TMR_TIMER24
            lda     #$02
            sta     TMR_TIMER32             ; Timer set for 1 second
            
@loop:      lda     UART_RXREG              ; clear RXREG
            lda     TMR_STATUS              ; read timer STATUS register
            bit     #%00000001              ; test OVRFL flag
            beq     @loop                   ; OVRFL == 0? loop
            
            rts

.endproc


;= U_GETC_1S ===================================================================
; Purges the UART input buffer.
;
; Parameters: none
; Returns:    none
;
; Destroys:   A, ERROR

.proc u_getc_1s
            
            stz     XERROR                  ; reset error code
            
            lda     #$80
            sta     TMR_TIMER08
            lda     #$F0
            sta     TMR_TIMER16
            lda     #$FA
            sta     TMR_TIMER24
            lda     #$02
            sta     TMR_TIMER32             ; set timer for 1 second
            
@loop:      lda     UART_STATUS             ; read UART STATUS register
            bit     #UART_RXFULL            ; check RXFULL flag
            bne     @done                   ; RXFULL == 0? check timer
            
            lda     TMR_STATUS              ; read timer STATUS register
            bit     #%00000001              ; check OVRFL flag
            beq     @loop                   ; OVRFL flag == 0? loop
            
            inc     XERROR                  ; time out
            
@done:      lda     UART_RXREG              ; read UART data
            
            rts

.endproc


;= UART_PUTC ===================================================================
; Sends a byte to the UART.
;
; Parameters: A = character
; Returns:    none
;
; Cycles (jsr->rts): 30 (assumes not busy)

.proc uart_putc
            
            pha                     ; save character
            
@poll:      lda     UART_STATUS     ; read UART STATUS register
            bit     #UART_TXBUSY    ; test TXBUSY flag
            bne     @poll           ; TXBUSY == 1?
            
            pla                     ; restore character
            sta     UART_TXREG      ; send it to UART
            
            rts

.endproc


;===============================================================================
; READ ONLY DATA
;===============================================================================

.RODATA

;= STRINGS =====================================================================

invcmd:     .BYTE "invalid command", LF, NUL

helpmsg:    .BYTE "dump", TAB, "$[address]", LF
            .BYTE "enter", TAB, "=address [byte]", LF
            .BYTE "go", TAB, "@address", LF
            .BYTE "help", TAB, "?", LF
            .BYTE "xmodem", TAB, ">address", LF, NUL

timeout_msg:  .BYTE "timeout", LF, NUL
fail_msg:     .BYTE "failed", LF, NUL
complete_msg: .BYTE " bytes received", LF, NUL
toolarge_msg: .BYTE "file too large", LF, NUL

.END
