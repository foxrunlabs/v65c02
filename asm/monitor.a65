.RODATA

inv_msg:    .BYTE "invalid command", LF, 0

help_msg:   .BYTE "dump", TAB, "D [address]", LF
            .BYTE "enter", TAB, "E address [byte]", LF
            .BYTE "go", TAB, "G [address]", LF
            .BYTE "help", TAB, "?", LF
            .BYTE "input", TAB, "I device register", LF
            .BYTE "output", TAB, "O device register byte", LF
            .BYTE "xmodem", TAB, "X [address]", LF, NUL

timeout_msg:  .BYTE "timeout", LF, NUL
fail_msg:     .BYTE "failed", LF, NUL
complete_msg: .BYTE " bytes received", LF, NUL
toolarge_msg: .BYTE "file too large", LF, NUL
