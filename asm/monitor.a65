;===============================================================================
; Program   : v65C02 BIOS
; File Name : monitor.a65
; Project   : v65C02 8-bit Computer
; Author    : Ryan Clarke
; E-mail    : kj6msg@icloud.com
;===============================================================================
; Purpose : ROM monitor for the v65C02 BIOS.
;===============================================================================


.PC02

.INCLUDE    "bios.inc"

.IMPORT     __VRAM_START__
.IMPORT     __VRAM_SIZE__

.EXPORT     monitor


;= BIOS CALL MACRO =============================================================

.macro      bios    num
            ldy     num
            jsr     bioscall
.endmacro


;= CONSTANTS ===================================================================

ATTRIB = (BLACK << 4) | LIGHT_GRAY      ; light gray on black text


;===============================================================================
; ROM MONITOR ENTRY POINT
;===============================================================================

.CODE

monitor:    lda     #VGA_CURS           ; CURS bit mask
            tsb     VGA_STATUS          ; set CURS bit
            
            lda     #.HIBYTE(B115200)
            sta     UART_BRGH
            lda     #.LOBYTE(B115200)
            sta     UART_BRGL           ; Initialize UART to 115200 baud
            
@prompt:    lda     #'-'
            bios    #1                  ; print command prompt
            
            ldx     #0                  ; X = string index
@getline:   lda     KBD_STATUS          ; retrieve keyboard STATUS register
            bit     #DATA_RDY           ; test DATA_RDY
            beq     @getline            ; DATA_RDY == 0? keep polling
            
            lda     KBD_RXREG           ; read the scan code
            tay
            lda     KBD_STATUS          ; retrieve keyboard STATUS register
            bit     #SHIFT              ; test SHIFT
            bne     @shifted
            lda     (KEYMAP), Y         ; convert to ASCII
            bra     @isnull
@shifted:   lda     (KEYMAPSH), Y
@isnull:    beq     @getline            ; ASCII character == 0? ignore non ASCII
            cmp     #ESC
            beq     @escape             ; escape key? process
            cmp     #TAB
            beq     @getline            ; tab key? process
            cmp     #BS
            beq     @backspace          ; backspace key? process
            
            pha                         ; save the character
            phx                         ; save string index
            bios    #1                  ; print character to screen
            plx                         ; restore string index
            pla                         ; restore the character
            
            cmp     #LF
            beq     @linefeed           ; line feed? process
            
            cpx     #9
            bcs     @getline            ; ignore input if > 9 characters
            
            sta     INPUT, X            ; add character to command string
            inx                         ; next string position
            bra     @getline            ; keep getting characters
            
@escape:    jsr     clrln               ; clear current line
            bra     @prompt             ; new prompt

@backspace: lda     COL                 ; A = current column
            cmp     #1                  ; check if beginning of prompt
            beq     @getline            ; column == 1? ignore backspace
            
            phx                         ; save the string index
            
            dec     A                   ; decrement column
            tax                         ; X = column--
            lda     ROW                 ; A = current row
            bios    #3                  ; move cursor to (column--, row)
            
            lda     #NUL                ; A = NUL character
            bios    #1                  ; clear the cursor position
            
            ldx     COL                 ; X = current column
            dex                         ; X = column--
            lda     ROW                 ; A = current row
            bios    #3                  ; reset cursor from printed NUL
            
            plx                         ; restore string index
            dex                         ; string index--
            
            bra     @getline            ; keep getting characters

@linefeed:  stz     INPUT, X            ; add NUL terminator

@isempty:   cpx     #0
            beq     @prompt             ; empty input string? try again
            
            ; validate input string format
            lda     INPUT+1             ; check 2nd character
            beq     @noparams           ; NUL? no parameters
            cmp     #' '
            bne     invalid             ; Not a space? invalid command
            
            lda     INPUT+6             ; check 7th character
            beq     @single             ; NUL? only one parameter
            cmp     #' '
            bne     invalid             ; Not a space? invalid command
            bra     @double             ; two parameters
            
            ; parse command
@noparams:  lda     INPUT
            cmp     #'?'
            beq     help                ; help command?
            cmp     #'g'
            beq     run                 ; run command?
            cmp     #'x'
            beq     xrecv               ; xmodem command?
            bra     invalid             ; invalid command
            
@single:    lda     INPUT
            cmp     #'d'
            beq     dump                ; dump command?
            bra     invalid             ; invalid command
            
@double:    lda     INPUT
            cmp     #'e'
            beq     write               ; write command?
            bra     invalid             ; invalid command
            
invalid:    ldx     #.HIBYTE(inv_msg)
            lda     #.LOBYTE(inv_msg)
            bios    #2                  ; print the invalid message
            
            jmp     monitor


;= DUMP ========================================================================

dump:       jsr     memdump             ; dump 16 bytes of memory to screen
            jmp     monitor             ; return to the monitor


;= HELP ========================================================================

help:       ldx     #.HIBYTE(help_msg)
            lda     #.LOBYTE(help_msg)
            bios    #2
            
            jmp     monitor


;= RUN =========================================================================

run:        jsr     $0200
            jmp     monitor


;= WRITE =======================================================================

write:      jsr     memwrite
            jmp     monitor


;= XMODEM ======================================================================

xrecv:      jsr     xmodem
            jmp     monitor


;===============================================================================
; SUBROUTINES
;===============================================================================

;= BIOSCALL ====================================================================
; Calls a BIOS routine.
;
; Parameters: Y = BIOS call number
;             X = parameter 1 (for two parameter calls)
;             A = parameter 2 (parameter 1 for single parameter calls)
; Returns:    none
;
; Destroys:   R0

.CODE

.proc bioscall
            
            sta     R0                  ; save parameter 2
            
            lda     (BIOSTH), Y         ; push high byte 1st
            pha
            lda     (BIOSTL), Y         ; push low byte 2nd (popped 1st on RTS)
            pha
            
            lda     R0                  ; restore parameter 2
                        
            rts                         ; jump to BIOS sub-routine

.endproc


;= CLRLN =======================================================================
; Clear a line with NUL characters and reset cursor to line beginning.
;
; Parameters: none
; Returns:    none
;
; Destroys: A, X, VRAML, VRAMH

.CODE

.proc clrln
            
            ldx     #0
            lda     ROW
            bios    #3                  ; set cursor to (0,ROW)
            
            lda     VGA_CURSH
            sta     VRAMH
            lda     VGA_CURSL
            sta     VRAML               ; (VRAM) = 11-bit cursor address
            
            asl     VRAML               ; 12-bit VRAM addr = cursor addr << 1
            rol     VRAMH               ; A = $0001 << 1
            lda     VRAMH
            ora     #.HIBYTE(__VRAM_START__)
            sta     VRAMH               ; (VRAM) = 16-bit VRAM address
                        
            ldx     #80                 ; 80 columns
@loop:      lda     #NUL
            sta     (VRAM)              ; write NUL character
            inc     VRAML               ; increment RAM address for attribute
            lda     #ATTRIB
            sta     (VRAM)              ; write attribute
            inc     VRAML               ; increment RAM address for next char
            bne     @next               ; rollover to 00? nope
            inc     VRAMH               ; VRAML rolled over to 00, increment
            
@next:      dex                         ; column counter--
            bne     @loop               ; 0?
            
            rts

.endproc


;= HTOU8 =======================================================================
; Converts a hexadecimal string to an 8-bit unsigned integer. Code inspired from
; Steve Wozniak's WOZ Monitor. Returns $00 for an invalid input.
;
; Parameters: X = hex high nibble
;             A = hex low nibble
; Returns:    A = uint8
;
; Destroys:   BYTE
;
; Cycles (jsr->rts): 36-63 (invalid high nibble - $FF)

.CODE

.proc htou8
            
            pha                         ; save hex low nibble
            txa                         ; A = hex high nibble
            eor     #'0'                ; map digits to 0-9
            cmp     #10                 ; check if within 0-9
            bcc     @validMSN           ; 0-9? valid
            
            adc     #$88                ; map "A"-"F" to $FA-FF
            cmp     #$FA                ; check if within $FA-FF
            bcc     @invalid            ; less than $FA? invalid
            
@validMSN:  asl     A                   ; shift result to high nibble
            asl     A
            asl     A
            asl     A
            sta     BYTE                ; save result to $0000
            
            pla                         ; A = hex low nibble
            eor     #'0'                ; map digits to 0-9
            cmp     #10                 ; check if within 0-9
            bcc     @validLSN           ; 0-9? valid
            
            adc     #$88                ; map "A"-"F" to $FA-FF
            cmp     #$FA                ; check if within $FA-FF
            bcc     @invalid            ; less than $FA? invalid
            and     #$0F                ; map to $0A-$0F
            
@validLSN:  ora     BYTE                ; combine high and low nibbles
            bra     @exit               ; done
            
@invalid:   pla                         ; clear the stack
            lda     #$00                ; invalid input = $00 value
            
@exit:      rts

.endproc


;= HTOU16 ======================================================================
; Converts a hexadecimal string to a 16-bit unsigned integer. Code inspired from
; Steve Wozniak's WOZ Monitor. Returns $0000 for an invalid input.
;
; Parameters: X = &hexstring<15:8>
;             A = &hexstring<7:0>
; Returns:    X = integer<15:8>
;             A = integer<7:0>
;
; Destroys:   Y, HSTRL, HSTRH, WORDL, WORDH
;
; Cycles (jsr->rts): 51-354

.CODE

.proc htou16

            stx     HSTRH
            sta     HSTRL               ; (HSTR) = hex string
            
            stz     WORDH
            stz     WORDL               ; WORD = 16-bit integer
            
            ldy     #0                  ; string index
@loop:      lda     (HSTR), Y           ; A = hex digit
            eor     #'0'                ; map digits to 0-9
            cmp     #10
            bcc     @valid              ; 0-9? valid
            
            adc     #$88                ; map "A"-"F" to $FA-FF
            cmp     #$FA
            bcc     @invalid            ; less than $FA? invalid
            
@valid:     asl     A                   ; shift into high nibble
            asl     A
            asl     A
            asl     A
            
            asl     A                   ; MSB to C
            rol     WORDL               ; C to LSB
            rol     WORDH               ; propagate result
            asl     A                   ; MSB to C
            rol     WORDL               ; C to LSB
            rol     WORDH               ; propagate result
            asl     A                   ; MSB to C
            rol     WORDL               ; C to LSB
            rol     WORDH               ; propagate result
            asl     A                   ; MSB to C
            rol     WORDL               ; C to LSB
            rol     WORDH               ; propagate result
            
            iny                         ; next character
            cpy     #4                  ; last one?
            bne     @loop               ; nope, continue
            bra     @done               ; yes, we're doing
            
@invalid:   ldx     #$00                ; invalid input = $0000 value
            lda     #$00
            bra     @exit

@done:      ldx     WORDH               ; 16-bit value stored at WORD
            lda     WORDL
            
@exit:      rts

.endproc


;= MEMDUMP =====================================================================
; Dump 16 bytes of memory to the screen
;
; Parameters: none
; Returns:    none

.proc memdump
            
            ldx     #$00
            lda     #INPUT+2
            jsr     htou16              ; convert hex string to uint16
            stx     MEMH
            sta     MEML                ; $(MEM) = start address
            
            ; take a snapshot of the memory
            ldy     #15                 ; Y = offset
@buffer:    lda     (MEM), Y            ; A = load memory
            sta     BUF, Y              ; store in buffer
            dey                         ; offset--
            bpl     @buffer             ; offset >= 0?
            
            ; print passed memory address
            txa                         ; MSB first
            jsr     u8toh               ; unsigned byte to hex
            bios    #2                  ; print MSB
            lda     MEML                ; LSB next
            jsr     u8toh               ; unsigned byte to hex
            bios    #2                  ; print LSB
            
            lda     #':'
            bios    #1
            lda     #' '
            bios    #1
            
            ldy     #0                  ; Y = offset
@bytes:     lda     BUF, Y              ; load buffered memory
            jsr     u8toh               ; convert byte to hex
            phy                         ; save Y
            bios    #2                  ; print hex
            lda     #' '
            bios    #1                  ; print a space
            
            ply                         ; restore Y
            iny                         ; next address
            cpy     #16
            bne     @bytes              ; offset < 16?
            
            lda     #'['                ; start ASCII display
            bios    #1
            
            ldy     #0                  ; Y = offset
@toascii:   lda     BUF, Y              ; load buffered memory
            phy                         ; save Y
            cmp     #$20                ; SPACE
            bcc     @notascii           ; value < SPACE?
            cmp     #$7F                ; DEL
            bcs     @notascii           ; value >= DEL?
            
            bios    #1                  ; print the ASCII representation
            bra     @next
            
@notascii:  lda     #'.'                ; print a period for unprintables
            bios    #1
            
@next:      ply                         ; restore Y
            iny                         ; offset++
            cpy     #16
            bne     @toascii            ; offset < 16?
            
            lda     #']'
            bios    #1                  ; end of ASCII display
            
            lda     #LF
            bios    #1                  ; line feed
            
            rts

.endproc


;= MEMWRITE ====================================================================
; Write byte to memory.
;
; Parameters: none
; Returns:    none

.proc memwrite
            
            ldx     #$00
            lda     #INPUT+2
            jsr     htou16              ; convert address hex string to uint16
            stx     MEMH
            sta     MEML                ; (DUMP) = address
            
            ldx     INPUT+7
            lda     INPUT+8
            jsr     htou8               ; convert value hex string to uint8
            sta     (MEM)
            pha                         ; save write value
            
            lda     MEMH                ; address MSB
            jsr     u8toh               ; convert address MSB to hex string
            bios    #2                  ; print address MSB
            lda     MEML                ; address LSB
            jsr     u8toh               ; convert address LSB to hex string
            bios    #2                  ; print address LSB
            lda     #':'
            bios    #1
            lda     #' '
            bios    #1
            
            pla                         ; A = write value
            jsr     u8toh               ; convert write value to hex string
            bios    #2                  ; print write value
            
            lda     #LF
            bios    #1
            
            rts

.endproc


;= U8TOH =======================================================================
; Converts 8-bit unsigned integer to null terminated hexadecimal string.
; Inspired by Steve Wozniak's WOZ Monitor.
;
; Parameters: A = uint8
; Returns:    X = &hexstring<15:8>
;             A = &hexstring<7:0>
;
; Destroys: DSTR
;
; Cycles (jsr->rts): 51

.CODE

.proc u8toh
            tax
            
            sed
            lsr     A
            lsr     A
            lsr     A
            lsr     A
            cmp     #$0A
            adc     #$30
            sta     DSTR
            
            txa
            and     #$0F
            cmp     #$0A
            adc     #$30
            sta     DSTR+1
            cld
            
            stz     DSTR+2
            
            ldx     #$00
            lda     #DSTR
            
            rts

.endproc


;= U16TOD ======================================================================
; Converts an unsigned 16-bit integer to a null-terminated string using the
; double dabble algorithm to first convert to BCD and then a conversion to
; ACII.
;
; Parameters: X = &integer<15:8>
;             A = &integer<7:0>
; Returns:    X = &string<15:8>
;             A = &string<7:0>
;
; Destroys: Y, DSTR

.CODE

.proc u16tod
            
            stz     DSTR                    ; set BCD bytes to 0
            stz     DSTR+1
            stz     DSTR+2
            stx     DSTR+3                  ; integer bytes furthest to the
            sta     DSTR+4                  ; right
            
            ; double-dabble to convert binary to BCD
            ldy     #16                     ; Y = 16 bits, 16 shifts
@dabble:    ldx     #2                      ; X = BCD packed byte counter
@lonibble:  lda     DSTR, X
            and     #$0F                    ; low nibble first
            cmp     #$05
            bcc     @hinibble               ; low nibble < 5?
            
            lda     DSTR, X                 ; low nibble is greater than 4
            clc
            adc     #$03                    ; add three to nibble
            sta     DSTR, X                 ; save back to BCD byte
            
@hinibble:  lda     DSTR, X
            and     #$F0                    ; high nibble
            cmp     #$50
            bcc     @next                   ; high nibble < 5?
            
            lda     DSTR, X                 ; high nibble is greater than 4
            clc
            adc     #$30                    ; add three to nibble
            sta     DSTR, X                 ; save back to BCD byte
            
@next:      dex                             ; nexy BCD packed byte
            bpl     @lonibble               ; X < 0?

            asl     DSTR+4                  ; 5 byte left shift
            rol     DSTR+3
            rol     DSTR+2
            rol     DSTR+1
            rol     DSTR
            
            dey                             ; shift counter--
            bne     @dabble                 ; Y > 0?
            
            ; convert BCD to ASCII
            ldx     #2                      ; X = BCD packed byte counter
            ldy     #4                      ; Y = null-terminated string counter
@toascii:   lda     DSTR, X                 ; load BCD byte
            and     #$0F                    ; low nibble first
            ora     #'0'                    ; map 0-9 to "0"-"9"
            sta     DSTR, Y                 ; store ASCII value
            
            dey                             ; next string position
            lda     DSTR, X                 ; load BCD byte
            lsr     A                       ; high nibble shift
            lsr     A
            lsr     A
            lsr     A
            ora     #'0'                    ; map 0-9 to "0"-"9"
            sta     DSTR, Y                 ; store ASCII value
            
            dey                             ; next string position
            dex                             ; next BCD byte
            bne     @toascii                ; byte > 0?
            
            lda     DSTR                    ; last BCD byte (low nibble only)
            ora     #'0'                    ; map first digit to "0"-"9"
            sta     DSTR                    ; store ASCII value
            
            stz     DSTR+5                  ; null terminator
            
            ; remove leading zeros
            ldx     #0                      ; check the first 4 digits
@zeros:     lda     DSTR, X                 ; load ASCII digit
            cmp     #'0'
            bne     @done                   ; ASCII digit == '0'?
            
            inx                             ; next ASCII digit
            cpx     #4
            bne     @zeros                  ; digit counter > 0?
            
@done:      txa
            clc
            adc     #DSTR
            ldx     #$00                    ; return value = DSTR
            
            rts

.endproc


;===============================================================================
; XMODEM RECEIVER
;===============================================================================

;= XMODEM ======================================================================
; Receives a file from the UART via the XMODEM protocol.
;
; Parameters: none
; Returns:    none
;
; Destroys:

.CODE

.proc xmodem
            
            lda     #1                      ; first block = 1
            sta     BLOCK
            stz     CHKSUM
            
            lda     #.HIBYTE($0200)
            sta     DATAH
            lda     #.LOBYTE($0200)
            sta     DATAL                   ; (DATA) = RAM address
            
            jsr     purge                   ; purge the UART receiver
            
            lda     #NAK
            jsr     uart_putc               ; send NAK to trigger sender
            
@start:     jsr     u_getc_1s               ; RX with 1 second timeout
            ldx     ERROR                   ; load error code
            beq     @cont                   ; no error, start the process
            jmp     @timeout                ; error > 0? timeout
            
@cont:      lda     UART_RXREG              ; get data from UART
            cmp     #EOT                    ; compared with <EOT>
            beq     @end                    ; data == <EOT>? end recv
            cmp     #SOH                    ; compared with <SOH>
            beq     @block                  ; data == <SOH>? get block #
            jmp     @fail                   ; else, we failed

@block:     jsr     u_getc_1s               ; RX with 1 second timeout
            ldx     ERROR                   ; load error code
            bne     @timeout                ; error > 0? timeout
            
            lda     UART_RXREG              ; read UART data
            cmp     BLOCK                   ; compare with expected block #
            beq     @block2
            jmp     @fail                   ; data != expected block, failure         
            
@block2:    jsr     u_getc_1s               ; RX with 1 second timeout
            ldx     ERROR                   ; load error code
            bne     @timeout                ; error > 0? timeout
            
            lda     UART_RXREG              ; read UART data to clear it
            
            ldy     #128                    ; 128 bytes of data per block            
@data:      jsr     u_getc_1s               ; RX with 1 second timeout
            ldx     ERROR                   ; load error code
            bne     @timeout                ; error > 0? timeout
            
            lda     UART_RXREG              ; read UART data
            sta     (DATA)                  ; store to RAM
            
            clc
            adc     CHKSUM
            sta     CHKSUM                  ; checksum += data (no carry)
            
            lda     DATAL
            clc
            adc     #$01
            sta     DATAL
            lda     DATAH
            adc     #$00
            sta     DATAH                   ; increment 16-bit addr at DATA
            
            dey                             ; byte counter--
            bne     @data                   ; counter > 0? keep getting data
            
            lda     DATAH                   ; load RAM address MSB
            cmp     #$80                    ; are we outside user RAM?
            beq     @toolarge               ; we are, failure
            
@chksum:    jsr     u_getc_1s               ; RX with 1 second timeout
            ldx     ERROR                   ; load error code
            bne     @timeout                ; error > 0? timeout
            
            lda     UART_RXREG              ; read UART data
            cmp     CHKSUM                  ; compare with computed checksum
            bne     @fail                   ; not equal? failure
            
            lda     #ACK
            jsr     uart_putc               ; send <ACK>
            inc     BLOCK                   ; increment block
            stz     CHKSUM                  ; reset checksum
            
            bra     @start                  ; wait for another block

@end:       lda     #ACK
            jsr     uart_putc               ; send <ACK>
            
            lda     #$00
            dec     BLOCK                   ; adjust blocks received by -1
            lsr     BLOCK                   ; divide by 2 (blocks-- in MSB)
            ldx     BLOCK                   ; save MSB to X
            ror     A                       ; 16-bit division by two (X,A)
            jsr     u16tod                  ; convert to string
            bios    #2                      ; print bytes received to screen
            
            ldx     #.HIBYTE(complete_msg)
            lda     #.LOBYTE(complete_msg)
            bios    #2                      ; complete string
            bra     @done
            
@timeout:   ldx     #.HIBYTE(timeout_msg)
            lda     #.LOBYTE(timeout_msg)
            bios    #2                      ; timeout string
            bra     @done                   ; done

@toolarge:  ldx     #.HIBYTE(toolarge_msg)
            lda     #.LOBYTE(toolarge_msg)
            bios    #2                      ; file too large string
            bra     @done                   ; done

@fail:      ldx     #.HIBYTE(fail_msg)
            lda     #.LOBYTE(fail_msg)
            bios    #2                      ; failed string

@done:      rts

.endproc


;= PURGE =======================================================================
; Purges the UART input buffer.
;
; Parameters: none
; Returns:    none
;
; Destroys:   A

.CODE

.proc purge
            
            lda     #$80
            sta     TMR_TIMER08
            lda     #$F0
            sta     TMR_TIMER16
            lda     #$FA
            sta     TMR_TIMER24
            lda     #$02
            sta     TMR_TIMER32             ; Timer set for 1 second
            
@loop:      lda     UART_RXREG              ; clear RXREG
            lda     TMR_STATUS              ; read timer STATUS register
            bit     #%00000001              ; test OVRFL flag
            beq     @loop                   ; OVRFL == 0? loop
            
            rts

.endproc


;= U_GETC_1S ===================================================================
; Purges the UART input buffer.
;
; Parameters: none
; Returns:    none
;
; Destroys:   A, ERROR

.CODE

.proc u_getc_1s
            
            stz     ERROR                   ; reset error code
            
            lda     #$80
            sta     TMR_TIMER08
            lda     #$F0
            sta     TMR_TIMER16
            lda     #$FA
            sta     TMR_TIMER24
            lda     #$02
            sta     TMR_TIMER32             ; set timer for 1 second
            
@loop:      lda     UART_STATUS             ; read UART STATUS register
            bit     #RXFULL                 ; check RXFULL flag
            bne     @done                   ; RXFULL == 0? check timer
            
            lda     TMR_STATUS              ; read timer STATUS register
            bit     #%00000001              ; check OVRFL flag
            beq     @loop                   ; OVRFL flag == 0? loop
            
            inc     ERROR                   ; time out
            
@done:      lda     UART_RXREG              ; read UART data
            
            rts

.endproc


;= UART_PUTC ===================================================================
; Sends a byte to the UART.
;
; Parameters: A = character
; Returns:    none
;
; Cycles (jsr->rts): 30 (assumes not busy)

.CODE

.proc uart_putc
            
            pha                     ; save character
            
@poll:      lda     UART_STATUS     ; read UART STATUS register
            bit     #TXBUSY         ; test TXBUSY flag
            bne     @poll           ; TXBUSY == 1?
            
            pla                     ; restore character
            sta     UART_TXREG      ; send it to UART
            
            rts

.endproc


