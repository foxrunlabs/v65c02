.PC02

.INCLUDE    "v65C02.inc"

.EXPORT     bioscall


;= BIOSCALL ====================================================================
; Calls a BIOS routine.
;
; Parameters: Y = BIOS call number
;             X = parameter 1 (for two parameter calls)
;             A = parameter 2 (parameter 1 for single parameter calls)
; Returns:    none
;
; Destroys:   R0

.CODE

.proc bioscall
            
            sta     R0                  ; save parameter 2
            
            lda     (BIOSTH), Y         ; push high byte 1st
            pha
            lda     (BIOSTL), Y         ; push low byte 2nd (popped 1st on RTS)
            pha
            
            lda     R0                  ; restore parameter 2
                        
            rts                         ; jump to BIOS sub-routine

.endproc


;= CLRSCR ======================================================================
; Clears the screen with NUL characters using the attribute stored at ATTR.
;
; Parameters: None
; Returns:    None
;
; Destroys:   A

.CODE

.proc clrscr
            
            lda     #VGA_EN
            trb     VGA_STATUS          ; VGA off
            
            lda     #.HIBYTE($B000)
            sta     VRAMH
            lda     #.LOBYTE($B000)
            sta     VRAML               ; (VRAM) = VRAM start address
            
            lda     #VGA_PAGE
            trb     VGA_STATUS          ; select display page
            
            ;- clear VRAM ------------------------------------------------------
@loop0:     lda     #NUL
            sta     (VRAM)              ; store NUL to VRAM
            
            lda     #VGA_PAGE
            tsb     VGA_STATUS          ; select attribute page
            
            lda     ATTR
            sta     (VRAM)              ; store ATTR to VRAM
            
            lda     #VGA_PAGE
            trb     VGA_STATUS          ; select display page
            
            inc     VRAML               ; increment VRAM address LSB
            bne     @loop0              ; roll over to $00? no, loop
            
            inc     VRAMH               ; increment VRAM address MSB
            lda     VRAMH
            cmp     #.HIBYTE($B000 + (80 * 30))
            bne     @loop0              ; equal to VRAM upper limit? no, loop
            
            stz     VGA_CURSH
            stz     VGA_CURSL           ; set cursor to (0,0)
            stz     COL
            stz     ROW                 ; update stored cursor coordinates
            
            lda     #VGA_EN
            tsb     VGA_STATUS          ; VGA on
            
            rts

.endproc
