; Purpose : Console input/output routines for the v65C02 8-bit Computer.
;===============================================================================


.PC02

.INCLUDE    "ascii.inc"
.INCLUDE    "colors.inc"
.INCLUDE    "conio.inc"
.INCLUDE    "memory.inc"

.EXPORT     clrln
.EXPORT     clrscr
.EXPORT     cputs
.EXPORT     gotoxy
.EXPORT     putch


;= CONSTANTS ===================================================================

ATTRIB = (BLACK << 4) | LIGHT_GRAY


;= CLEAR LINE --================================================================
; Clear a line with NUL characters and light gray on black text attribute.
;
; Parameters: A = line number
; Returns:    none
;
; Destroys: X, VRAML, VRAMH
;
; Cycles (jsr->rts): 4549

.CODE

clrln:      ldx     #0
            jsr     gotoxy              ; set cursor to (0,A)
            
            lda     VGA_CURSH
            sta     VRAMH
            lda     VGA_CURSL
            sta     VRAML               ; (VRAM) = 11-bit cursor address
            
            asl     VRAML               ; 12-bit VRAM addr = cursor addr << 1
            rol     VRAMH               ; A = $0001 << 1
            lda     VRAMH
            ora     #.HIBYTE(VRAM_START); create 16-bit memory address
            sta     VRAMH               ; (VRAM) = 16-bit VRAM address
            
            ldx     #80                 ; X = column counter
@loop:      lda     #NUL                ; A = NUL character
            sta     (VRAM)              ; store NUL to VRAM

            lda     #$01
            clc
            adc     VRAML
            sta     VRAML
            lda     VRAMH
            adc     #$00
            sta     VRAMH               ; (VRAM) + $0001

            lda     #ATTRIB             ; A = attribute
            sta     (VRAM)              ; store attribute to VRAM
            
            lda     #$01
            clc
            adc     VRAML
            sta     VRAML
            lda     VRAMH
            adc     #$00
            sta     VRAMH               ; (VRAM) + $0001
            
            dex
            bne     @loop
            
            rts


;= CLEAR SCREEN ================================================================
; Clear the screen with NUL characters and light gray on black text attribute.
;
; Parameters: none
; Returns:    none
;
; Destroys: VRAML, VRAMH
;
; Cycles (jsr->rts): 110783

.CODE

clrscr:     lda     #.HIBYTE(VRAM_START)
            sta     VRAMH
            lda     #.LOBYTE(VRAM_START)
            sta     VRAML               ; (VRAM) = VRAM address
            
@loop:      lda     #NUL                ; A = NUL character
            sta     (VRAM)              ; store NUL to VRAM
            inc     VRAML               ; increment VRAM address LSB
            lda     #ATTRIB             ; A = attribute
            sta     (VRAM)              ; store attribute to VRAM
            inc     VRAML               ; increment VRAM address LSB
            bne     @loop               ; $0000 > 0? loop
            
            inc     VRAMH               ; increment VRAM address MSB
            lda     VRAMH               ; A = VRAM address MSB
            cmp     #.HIBYTE(VRAM_END)  ; compare VRAM addr w/ VRAM end (MSBs)
            bne     @loop               ; VRAM address MSB < end? loop
            
            stz     VGA_CURSH
            stz     VGA_CURSL           ; set cursor to (0,0)
            stz     COL
            stz     ROW                 ; update stored cursor coordinates
            
            rts


;= PRINT NULL-TERMINATED STRING ================================================
; Prints a NUL terminated string to the screen. Updates the cursor position
; after printing.
;
; Parameters: X = &string<15:8>
;             A = &string<7:0>
; Returns:    none
;
; Destroys: Y, STRL, STRH
;
; Cycles (jsr->rts): 48 - [205 * strlen + 8]

.CODE

cputs:      stx     STRH
            sta     STRL                ; (STR) = string address
            
            cursor_off                  ; turn cursor off
            
            ldy     #0                  ; Y = string index
@loop:      lda     (STR), Y            ; A = string character
            beq     @done               ; character == NUL? done
            
            jsr     putch
            iny                         ; index++
            bra     @loop               ; next character
            
@done:      cursor_on                   ; turn cursor on
            
            rts


;= MOVE CURSOR =================================================================
; Moves the cursor to a screen position.
;
; Parameters: X = column
;             A = row
; Returns:    none
;
; Destroys: CURSL, CURSH, CURST
;
; Cycles (jsr->rts): 102

.CODE

gotoxy:     cpx     #80
            bcs     @done               ; column >= 80? done
            cmp     #25
            bcs     @done               ; row >= 25? done
            
            stx     COL
            sta     ROW                 ; update stored cursor coordinates
            
            stx     CURSL
            stz     CURSH               ; CURS = column (16-bit)
            stz     CURST               ; CURST,A = row (16-bit)
            
            asl     A
            asl     A
            asl     A
            asl     A                   ; don't have to carry until 4th shift
            rol     CURST               ; CURST,A = row << 4
            pha                         ; push A
            
            adc     CURSL               ; carry already cleared
            sta     CURSL
            lda     CURSH
            adc     CURST
            sta     CURSH               ; CURS = column + (row << 4)
            
            pla                         ; CURST,A = row << 4
            asl     A
            rol     CURST
            asl     A
            rol     CURST               ; CURST,A = row << 6
            
            ; VGA cursor address = column + (row << 4) + (row << 6)
            ; $0000 = column + (row << 4)
            ; $0002,A = row << 6
            clc
            adc     CURSL
            sta     VGA_CURSL
            lda     CURSH
            adc     CURST
            sta     VGA_CURSH
            
@done:      rts


;= PRINT CHARACTER =============================================================
; Prints a character to the screen. Updates the cursor position after printing.
;
; Parameters: A = character
; Returns:    none
;
; Destroys: X, VRAML, VRAMH, CTAB
;
; Cycles (jsr->rts): 63-193

.CODE

putch:      pha                         ; push character to the stack
            
            lda     VGA_CURSH
            sta     VRAMH
            lda     VGA_CURSL
            sta     VRAML               ; (VRAM) = 11-bit cursor address
            
            asl     VRAML               ; 12-bit VRAM addr = cursor addr << 1
            rol     VRAMH               ; A = $0001 << 1
            lda     VRAMH
            ora     #.HIBYTE(VRAM_START); create 16-bit memory address
            sta     VRAMH               ; (VRAM) = 16-bit VRAM address
            
            pla                         ; pull character from the stack
            cmp     #LF
            beq     @newline            ; character == LF? newline
            cmp     #TAB
            beq     @tab                ; character == TAB? tab
            
@printable: sta     (VRAM)              ; write the character to VRAM
            
            ldx     COL                 ; X = current column
            cpx     #79
            beq     @newline            ; column == 79? newline

            inx                         ; column++
            lda     ROW                 ; A = current row
            bra     @cursor             ; update cursor position
            
@tab:       lda     COL                 ; A = column
            cmp     #72
            bcs     @newline            ; column >= 72
            
            and     #%00000111          ; A = column % 8
            sta     COL8                ; save value into COL8
            lda     #8
            sec
            sbc     COL8                ; A = 8 - (column % 8)
            clc
            adc     COL                 ; add to column
            tax                         ; X = column
            lda     ROW                 ; A = row
            bra     @cursor             ; update cursor
            
@newline:   lda     ROW
            cmp     #24
            beq     @done               ; row == 24? done
            
            ldx     #0                  ; column = 0
            inc     A                   ; row++
@cursor:    jsr     gotoxy              ; update cursor position
            
@done:      rts
